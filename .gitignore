# build output
dist/

# Cloudflare API token (秘密情報)
.cf_token
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# 保有データの元ファイル（実ポジション・打診リストを含むため公開リポジトリには入れない）
portfolio-holdings.xlsx

# ダッシュボードの旧版（差し替え前の控えをローカルに置いてあるだけ。公開リポジトリには入れない）
_archive/

# Python のキャッシュ
__pycache__/

# 有料記事の配布物（公開リポジトリなので、ランダムトークン付きURLの意味がなくなる）
# 実体は numasoko-reports-backup/04_note原稿/_配布物/ にミラーしている
public/downloads/*
# ただし旧URLの無効化ファイル（中身は注意書き124バイトのみ）は残す。
# これを消すと、Pages が「そのパスで最後に配信したもの」を返し続けて旧URLが復活する。
!public/downloads/naibu-fukuri-hanbetsu-sheet.xlsx
!public/downloads/naibu-fukuri-hanbetsu-sheet-30ef570937d6.xlsx
!public/downloads/kenri-hanbetsu-sheet-1cdeb9e94ada.xlsx
!public/downloads/numasoko-score-sheet-1648fe2630ac.xlsx
!public/downloads/numasoko-score-tool-f5d269a77ece.html
