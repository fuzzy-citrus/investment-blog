---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { contentThemes } from '../data/contentMap';

const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
const byId = new Map(posts.map((p) => [p.id, p]));

// テーマに割り当て済みのスラッグ集合
const mapped = new Set(contentThemes.flatMap((t) => t.slugs));
// どのテーマにも入っていない公開記事（新着で割り当て忘れの検知用）
const unclassified = posts
  .filter((p) => !mapped.has(p.id))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const isStock = (id: string) => Boolean(byId.get(id)?.data.stockCard);
const ticker = (id: string) => byId.get(id)?.data.stockCard?.ticker ?? '';
const company = (id: string) => byId.get(id)?.data.stockCard?.companyName ?? byId.get(id)?.data.title ?? id;
const colTitle = (id: string) => byId.get(id)?.data.title ?? id;
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title="コンテンツマップ | バリュー商会" description="沼底バリュー商会の銘柄紹介・投資コラムを、投資テーマと担当キャラ（発信元）で体系化したマップ。資産バリュー・ニッチ独占・TOB・資金管理・投資哲学の5領域から記事を探せます。" />
  </head>
  <body>
    <Header />
    <main>
      <div class="page-header">
        <h1>コンテンツマップ</h1>
        <p class="lead">銘柄紹介とコラムを「投資テーマ × 担当キャラ（発信元）」で体系化しました。気になる切り口から記事を探せます。</p>
      </div>

      <div class="map-grid">
        {contentThemes.map((theme) => {
          const articles = theme.slugs.filter((s) => byId.has(s));
          return (
            <section id={theme.id} class={`theme-card${articles.length === 0 ? ' is-empty' : ''}`} style="scroll-margin-top:90px">
              <div class="theme-head" style={`background:${theme.fill}`}>
                <div class="theme-name" style={`color:${theme.text}`}>{theme.name}</div>
                <div class="theme-owner" style={`color:${theme.sub}`}>{theme.owners}</div>
              </div>
              <div class="theme-body">
                {articles.map((s) => (
                  <a href={`/blog/${s}/`} class="map-item" style={`--accent:${theme.sub}`}>
                    {isStock(s) ? (
                      <>
                        <span class="mi-title" style={`color:${theme.text}`}>{company(s)}</span>
                        <span class="mi-ticker" style={`color:${theme.sub}`}>{ticker(s)}</span>
                      </>
                    ) : (
                      <span class="mi-col" style={`color:${theme.sub}`}>💡 {colTitle(s)}</span>
                    )}
                  </a>
                ))}
                {theme.note && articles.length === 0 && (
                  <p class="theme-note" style={`color:${theme.sub};border-color:${theme.border}`}>⚠️ {theme.note}</p>
                )}
              </div>
            </section>
          );
        })}
      </div>

      {unclassified.length > 0 && (
        <section class="unclassified">
          <h2>未分類の記事</h2>
          <p class="lead">テーマ未割り当ての記事です（<code>src/data/contentMap.ts</code> に追加してください）。</p>
          <ul>
            {unclassified.map((p) => (
              <li><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>
            ))}
          </ul>
        </section>
      )}
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 2.5em 1em 4em;
  }
  .page-header { margin-bottom: 1.8em; }
  h1 {
    font-size: 1.5em;
    color: var(--accent-dark);
    border-left: 4px solid var(--accent);
    padding-left: 0.6em;
    margin-bottom: 0.4em;
  }
  .lead { color: rgb(var(--gray-dark)); font-size: 0.9em; line-height: 1.6; margin: 0; }
  .map-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1em;
  }
  .theme-card {
    border: 1px solid #e4e8ee;
    border-radius: 10px;
    overflow: hidden;
    background: white;
    box-shadow: 0 1px 4px rgba(0,0,0,5%);
  }
  .theme-card.is-empty { border-style: dashed; }
  .theme-head { padding: 0.7em 1em; }
  .theme-name { font-size: 1em; font-weight: 700; line-height: 1.3; }
  .theme-owner { font-size: 0.8em; margin-top: 0.2em; }
  .theme-body {
    padding: 0.6em 0.8em;
    display: flex;
    flex-direction: column;
    gap: 0.1em;
    max-height: 340px;
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .theme-body::-webkit-scrollbar { width: 7px; }
  .theme-body::-webkit-scrollbar-thumb { background: #d3dae3; border-radius: 4px; }
  .theme-body::-webkit-scrollbar-thumb:hover { background: #b9c2cd; }
  .map-item {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    padding: 0.5em 0.5em;
    border-radius: 6px;
    text-decoration: none;
    border-left: 3px solid transparent;
    transition: background 0.12s, border-color 0.12s;
  }
  .map-item:hover { background: #f6f8fa; border-left-color: var(--accent); }
  .mi-title { font-size: 0.9em; font-weight: 700; }
  .mi-ticker { font-size: 0.78em; font-variant-numeric: tabular-nums; }
  .mi-col { font-size: 0.85em; font-weight: 600; line-height: 1.4; }
  .theme-note {
    font-size: 0.8em;
    line-height: 1.6;
    margin: 0.3em 0.2em;
    padding: 0.6em 0.7em;
    border: 1px dashed;
    border-radius: 6px;
  }
  .unclassified {
    margin-top: 2em;
    padding: 1.2em 1.4em;
    background: #fff8f0;
    border: 1px solid #f0d8b8;
    border-radius: 10px;
  }
  .unclassified h2 { font-size: 1.1em; color: #8a5a00; margin: 0 0 0.3em; }
  .unclassified ul { margin: 0.6em 0 0; padding-left: 1.2em; }
  .unclassified a { color: var(--accent-dark); }
</style>
