</style>

<script>
  document.querySelectorAll<HTMLElement>('.member-emojis').forEach(group => {
    const cards = [...group.querySelectorAll<HTMLDetailsElement>('.member-item')];
    const close = (card: HTMLDetailsElement) => { card.open = false; delete card.dataset.pinned; };
    const show = (card: HTMLDetailsElement) => { cards.filter(c => c !== card).forEach(close); card.open = true; };
    cards.forEach(card => {
      const summary = card.querySelector('summary')!;
      summary.addEventListener('pointerenter', event => { if (event.pointerType === 'mouse') show(card); });
      summary.addEventListener('focus', () => show(card));
      summary.addEventListener('click', event => {
        event.preventDefault();
        if (card.dataset.pinned) close(card);
        else { show(card); card.dataset.pinned = 'true'; }
      });
    });
    group.addEventListener('pointerleave', () => cards.filter(c => !c.dataset.pinned && !c.contains(document.activeElement)).forEach(close));
    group.addEventListener('focusout', event => { if (!group.contains(event.relatedTarget as Node)) cards.forEach(close); });
    group.addEventListener('keydown', event => { if (event.key === 'Escape') { cards.forEach(close); } });
    document.addEventListener('pointerdown', event => { if (!group.contains(event.target as Node)) cards.forEach(close); });
  });
</script>
