---
import CastIcon from '../components/CastIcon.astro';
import VideoDialog from '../components/VideoDialog.astro';
import VideoButton from '../components/VideoButton.astro';
import Comments from '../components/Comments.astro';
import StockRankSummary from '../components/StockRankSummary.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { siteUpdates } from '../data/siteUpdates';
import { Picture } from 'astro:assets';
import { comics } from '../data/comics';

const allPosts = (await getCollection('blog'))
	.filter(p => !p.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const posts = allPosts.slice(0, 10);
// 四コマは新しい順。横スクロールで2話ぶんずつ見せる
const comicStrip = [...comics].sort((a, b) => b.episode - a.episode);
const latestComic = comicStrip[0];
const comicDate = (() => {
	const [y, m, d] = latestComic.pubDate.split('-').map(Number);
	return `${y}年${m}月${d}日`;
})();
const latestPost = allPosts[0];
// コラムは新着順（pubDate降順）で表示
const columns = allPosts.filter(p => !p.data.stockCard);

// 📊 保有銘柄と損益ボタンの副題：public/holdings.html から基準日と銘柄数を読む
// 最新ポートフォリオを作り直せばボタンの日付も自動で追従する（手打ちしない）
let holdingsAsOf = '';
let holdingsCount = 0;
try {
	const fs = await import('node:fs');
	const path = await import('node:path');
	const raw = fs.readFileSync(path.join(process.cwd(), 'public', 'holdings.html'), 'utf-8');
	const m = raw.match(/asof["']?\s*:\s*["']([\d/\-]+)/);
	if (m) holdingsAsOf = m[1].replace(/-/g, '/');
	// 同じ銘柄を現物と信用で持つ建玉があるため、コードを重複排除して「銘柄数」を数える。
	// 出現回数をそのまま数えると positions 172 + noPrice 2 = 174 になり、実体（166銘柄）と食い違う。
	const codes = raw.match(/"code"\s*:\s*"([^"]+)"/g);
	if (codes) holdingsCount = new Set(codes).size;
} catch {
	// 最新ポートフォリオ未設置でもトップページは壊さない
}
const holdingsSub = holdingsAsOf
	? `${holdingsAsOf} 終値${holdingsCount ? `・${holdingsCount}銘柄` : ''}`
	: '全ポジションの一覧';

// ヒーローに表示する最終更新日時（siteUpdates の先頭。未登録時は最新記事へフォールバック）
// 記事の公開とサイト改修のうち、新しいほうを最終更新として出す
const siteAt = siteUpdates[0] ? new Date(siteUpdates[0].at) : undefined;
const postAt = allPosts[0]?.data.pubDate;
const latestUpdate = siteAt && postAt ? (siteAt > postAt ? siteAt : postAt) : (siteAt ?? postAt);
const latestUpdateLabel = latestUpdate?.toLocaleString('ja-JP', {
	timeZone: 'Asia/Tokyo',
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	hour: '2-digit',
	minute: '2-digit',
	hour12: false,
});


// メンバー紹介の設定を、トップページ向けの一言に要約。
const memberHints = [
  {
    "id": "machibuse",
    "name": "待伏 静江",
    "role": "TOB発掘",
    "reason": "ワニは、じっと待ち伏せ。狙った銘柄を見守り、TOBなどの変化の兆しを待ちます。"
  },
  {
    "id": "kawachi",
    "name": "河内 拾造",
    "role": "割安発掘",
    "reason": "カワウソの宝探し係。石の下をのぞくように、決算書に隠れた資産や含み益を探します。"
  },
  {
    "id": "hotta",
    "name": "堀田 独占",
    "role": "競合優位性",
    "reason": "ビーバーは自分でダムを作るから、モート（参入障壁）を重視。「競合がまねできない強み」を見抜きます。"
  },
  {
    "id": "yomi",
    "name": "夜見 賢三",
    "role": "財務分析",
    "reason": "フクロウは暗闇でも目が利く。目立たない決算書の注記まで読み込み、数字の裏側を確かめます。"
  },
  {
    "id": "yuda",
    "name": "優田 雅代",
    "role": "株主優待",
    "reason": "フラミンゴのように、バランスが大事。配当だけでなく優待も合わせて、お得さを見極めます。"
  },
  {
    "id": "hanaoka",
    "name": "花岡 利次郎",
    "role": "高配当",
    "reason": "ミツバチが蜜を集めるように、配当をこつこつ。「この配当は続く？」まで確かめる担当です。"
  },
  {
    "id": "morita",
    "name": "守田 退三",
    "role": "リスク管理",
    "reason": "ザリガニは後退が得意。買う前から「下がったらどうする？」を考える、商会のブレーキ役です。"
  },
  {
    "id": "sumida",
    "name": "墨田 検二",
    "role": "AIチェック",
    "reason": "イカの10本の腕で情報を照合するイメージ。AIの答えをうのみにせず、元の開示資料まで確かめます。"
  },
  {
    "id": "hinata",
    "name": "日向 昇",
    "role": "見習い",
    "trainee": true,
    "reason": "トカゲは外の気温で体温が変わる。上がっている株を見ると熱くなる見習いで、担当たちのツッコミを引き出す係です。"
  }
];

---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<figure class="hero-visual">
					<img src="/images/brand/numasoko-research-room-20260914.png" alt="沼底バリュー商会のメンバーが一次資料や決算書を囲んで企業価値を調べるイラスト" loading="eager" fetchpriority="high" />
					<button type="button" class="hero-play" data-video-open="company" aria-label="会社紹介の動画を見る（50秒）">
						<span class="hero-play-circle"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg></span>
						<span class="hero-play-label">会社紹介 50秒</span>
					</button>
					<button type="button" class="hero-play hero-play-members" data-video-open="members" aria-label="部下たちの紹介動画を見る（2分3秒）">
						<span class="hero-play-circle"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg></span>
						<span class="hero-play-label">部下紹介 2分</span>
					</button>
				</figure>
				<div class="hero-badge">🌱 沼底バリュー商会</div>
				<h1>見えない価値を、見つけにいこう。</h1>
				<p class="hero-desc"><span class="hero-desc-wide">割安株・TOB/MBO・資産価値・高配当を、一次資料と数字で確かめます。</span><span class="hero-desc-mobile">一次資料と数字で、企業価値を確かめます。</span></p>
				<div class="hero-tags">
					<a class="tag" href="/map#asset-value"><span class="tag-emoji">🦦</span>資産バリュー</a>
					<a class="tag" href="/map#moat"><span class="tag-emoji">🦫</span>ニッチ独占</a>
					<a class="tag" href="/map#tob-event"><span class="tag-emoji">🐊</span>TOB発掘</a>
					<a class="tag" href="/map#risk-leverage"><span class="tag-emoji">🧓</span>野村流</a>
					<a class="tag" href="/map#philosophy"><span class="tag-emoji">🧑‍💼</span>投資哲学</a>
					<a class="tag" href="/map#income"><span class="tag-emoji">🐝</span>高配当・増配</a>
				</div>
				<div class="hero-concept-wrap">
					<a href="/start/" class="hero-concept-btn is-new">
						<span class="hero-concept-icon">🧭</span>
						<span class="hero-concept-text">
							<span class="hero-concept-new">START</span>
							<span class="hero-concept-label">初めての方へ</span>
							<span class="hero-concept-sub">まず読む順番を3分で案内</span>
						</span>
						<span class="hero-concept-arrow">→</span>
					</a>
					<a href="/concept/" class="hero-concept-btn">
						<span class="hero-concept-icon">💎</span>
						<span class="hero-concept-text">
							<span class="hero-concept-label">経営コンセプト</span>
							<span class="hero-concept-sub">投資哲学と買い方</span>
						</span>
						<span class="hero-concept-arrow">→</span>
					</a>
					<a href="/holdings" class="hero-concept-btn is-new">
						<span class="hero-concept-icon">📊</span>
						<span class="hero-concept-text">
							<span class="hero-concept-new">NEW</span>
							<span class="hero-concept-label">最新ポートフォリオ</span>
							<span class="hero-concept-sub">{holdingsSub}</span>
						</span>
						<span class="hero-concept-arrow">→</span>
					</a>
					<a href="/margin/" class="hero-concept-btn">
						<span class="hero-concept-icon">🧓</span>
						<span class="hero-concept-text">
							<span class="hero-concept-label">野村流信用錬金術</span>
							<span class="hero-concept-sub">低金利レバレッジ</span>
						</span>
						<span class="hero-concept-arrow">→</span>
					</a>
					<a href="/value/" class="hero-concept-btn">
						<span class="hero-concept-icon">🦦</span>
						<span class="hero-concept-text">
							<span class="hero-concept-label">バリュー株の魅力</span>
							<span class="hero-concept-sub">割安株投資の体系</span>
						</span>
						<span class="hero-concept-arrow">→</span>
					</a>
					<a href="/note/" class="hero-concept-btn is-new">
						<span class="hero-concept-icon">📕</span>
						<span class="hero-concept-text">
							<span class="hero-concept-new">NEW</span>
							<span class="hero-concept-label">note を始めました</span>
							<span class="hero-concept-sub">銘柄ではなく手順を売る</span>
						</span>
						<span class="hero-concept-arrow">→</span>
					</a>
				</div>
				{latestUpdateLabel && latestPost && (
					<div class="hero-latest" aria-label="最終更新と最新記事">
						<span class="hero-latest-update">🗓️ 最終更新 {latestUpdateLabel}</span>
						<span class="hero-latest-sep" aria-hidden="true">｜</span>
						<a class="hero-latest-article" href={`/blog/${latestPost.id}/`}>
							<span class="hero-latest-article-label">最新記事</span>
							<strong>{latestPost.data.title}</strong>
							<span class="hero-latest-arrow" aria-hidden="true">→</span>
						</a>
					</div>
				)}
			</section>


			<section class="first-visit-intro" aria-labelledby="first-visit-title">
				<div class="first-visit-copy">
					<span class="first-visit-kicker">初めて読む方へ</span>
					<h2 id="first-visit-title">結論だけでなく、考え方と答え合わせまで公開します</h2>
					<p>無料ブログでは一次資料から個別株を検証し、紹介後の値動きや訂正も残します。分析を自分で再現したい方向けには、noteで手順・判定基準・チェックリストをまとめています。</p>
					<a href="/start/" class="first-visit-main">読む順番を3分で見る →</a>
				</div>
				<div class="first-visit-steps">
					<a href="/blog/" class="first-visit-step"><strong>1. 読む</strong><span>無料の分析記事から入る</span></a>
					<a href="/blog/scorecard-45-stocks-2026q3/" class="first-visit-step"><strong>2. 確かめる</strong><span>通信簿で紹介後を見る</span></a>
					<a href="/note/" class="first-visit-step"><strong>3. 再現する</strong><span>分析手順とツールを見る</span></a>
				</div>
			</section>

			<section class="comics-teaser" aria-labelledby="comics-teaser-title">
				<div class="comics-teaser-copy">
					<span class="first-visit-kicker">初心者向け・四コマ漫画</span>
					<h2 id="comics-teaser-title">四コマで学ぶ投資のキホン</h2>
					<p>見習いの日向が勘違いする前編と、正しい考え方にたどり着く後編のセット。読み終えたら解説記事へ進めます。</p>
					<a href="/comics/" class="first-visit-main">四コマ一覧を見る →</a>
				</div>
				<div class="comics-teaser-strip">
					<ul class="comics-teaser-list">
						{comicStrip.map((c) => (
							<li>
								<a href={`/comics/${c.slug}/`} aria-label={`四コマ 第${c.episode}話「${c.title}」前編・後編を読む`}>
									<Picture src={c.parts[0].image} alt="" formats={['avif', 'webp']} widths={[140, 280]} sizes="140px" loading="lazy" decoding="async" />
								</a>
							</li>
						))}
					</ul>
					<p class="comics-teaser-latest">
						<span class="comics-teaser-label">最新話</span>
						<a href={`/comics/${latestComic.slug}/`}>第{latestComic.episode}話「{latestComic.title}」</a>
						<span class="comics-teaser-date">{comicDate} 更新</span>
					</p>
				</div>
			</section>

			<div class="wl-col-grid">

				<StockRankSummary posts={allPosts} />

				<section class="columns-section">
					<div class="columns-header">
						<span class="columns-title">📝 投資コラム</span>
						<a href="/blog/?type=column" class="columns-all-link">すべて見る →</a>
					</div>
					<div class="columns-rows">
						{columns.map((post) => (
							<a href={`/blog/${post.id}/`} class="col-row">
								<span class="col-icon">📖</span>
								<span class="col-title">{post.data.title}</span>
								<span class="col-date"><FormattedDate date={post.data.pubDate} /></span>
								<span class="col-arrow">→</span>
							</a>
						))}
					</div>
				</section>

			</div>

			<section class="members-teaser">
				<h2>メンバー紹介</h2>
				<p>バリュー商会には8人の分析担当と、見習いが1人います</p>
				<p class="member-hint-guide">キャラにカーソルを合わせるか、タップすると担当の由来が読めます。</p>
				<VideoButton id="members" label="4班の紹介動画を見る" duration="2分" />
				<div class="member-emojis">
					{memberHints.map(c => (
						<details class:list={['member-item', { 'is-trainee': c.trainee }]}>
							<summary aria-label={c.trainee ? `${c.name}：見習いとして商会にいる理由` : `${c.name}：${c.role}を担当する理由`}>
								<CastIcon id={c.id} name={c.name} />
								<span class="member-role">{c.role}</span>
							</summary>
							<div class="member-note">
								<strong>{c.name}</strong>
								<p>{c.reason}</p>
								<a href={`/characters#${c.id}`}>詳しい紹介を見る →</a>
							</div>
						</details>
					))}
				</div>
				<a href="/org" class="all-posts-link">組織図で見る →</a>
			</section>

			<section class="posts-section">
				<h2>最新記事</h2>
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<span class="post-title">{post.data.title}</span>
								<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
							</a>
						</li>
					))}
				</ul>
				<a href="/blog" class="all-posts-link">すべての記事を見る →</a>
			</section>

			<div class="method-note">
				<span class="method-icon">🤖</span>
				<div>
					<p>掲載している「期待株価」は、複数AIによるベア・ベース・ブル3ケースの確率加重平均です。<strong>今すぐ株価が収束する想定ではなく、3年程度保有した場合の到達目安</strong>です。参考値であり投資勧誘ではありません。</p>
					<p>不動産含み益は「有価証券報告書に記載の物件所在地・地積・取得時期」と「国土交通省の公示価格データ」を照合し、AIによるエリア別地価分析で算出しています。<strong>実際の物件情報ベース</strong>なので精度は相応にあるはずです。ブレはあります。</p>
				</div>
			</div>

				<VideoDialog
				id="company"
				src="/videos/company-intro.mp4"
				poster="/videos/company-intro-poster.jpg"
				label="沼底バリュー商会の会社紹介"
			/>
			<VideoDialog
				id="members"
				src="/videos/members-intro.mp4"
				poster="/videos/members-intro-poster.jpg"
				label="沼底バリュー商会のメンバー紹介"
			/>
		</main>
		<Footer />

	</body>
</html>

<style>
	/* ── Hero Concept Button ── */
	.hero-concept-wrap {
		margin-top: 1.1em;
		display: flex;
		gap: 6px;
		justify-content: center;
		flex-wrap: wrap;
		max-width: 940px;
		margin-inline: auto;
	}
	.hero-concept-btn {
		flex: 1 1 0;
		box-sizing: border-box;
		min-width: 0;
		max-width: 172px;
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.22em;
		background: rgba(255,255,255,0.92);
		border: 1.5px solid rgba(232,184,75,0.7);
		border-radius: 8px;
		padding: 0.28em 0.4em 0.28em 0.38em;
		text-decoration: none;
		box-shadow: 0 2px 8px rgba(0,0,0,0.08);
		transition: background 0.15s, transform 0.1s;
		min-height: 76px;
	}
	.hero-concept-btn:hover {
		background: #fff;
		transform: translateY(-1px);
		border-color: #e8b84b;
	}
	.hero-concept-icon { font-size: 0.82em; flex-shrink: 0; }
	.hero-concept-text {
		display: flex;
		flex-direction: column;
		gap: 0.05em;
		min-width: 0;
		flex: 1;
		overflow: visible;
	}
	.hero-concept-label {
		font-size: 0.58em;
		white-space: normal;
		font-weight: 900;
		color: #1a3a5c;
		letter-spacing: 0.01em;
		line-height: 1.28;
	}
	.hero-concept-sub {
		font-size: 0.44em;
		color: #888;
		white-space: normal;
		overflow: visible;
		text-overflow: clip;
		line-height: 1.35;
	}
	/* 新設ページの目印。ボタンの枠外に出す */
	.hero-concept-new {
		position: absolute;
		top: -9px;
		right: -7px;
		background: #e0453a;
		color: #fff;
		font-size: 0.5em;
		font-weight: 900;
		letter-spacing: 0.08em;
		padding: 2px 7px;
		border-radius: 999px;
		box-shadow: 0 2px 6px rgba(224,69,58,0.4);
		z-index: 2;
	}
	.hero-concept-arrow {
		font-size: 0.58em;
		flex-shrink: 0;
		font-weight: 700;
		color: #b8860b;
	}
	@media (max-width: 1180px) {
		.hero-concept-arrow { display: none; }
	}
	.hero-latest { margin: 1em auto 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: 4px 10px; font-size: 13px; line-height: 1.7; }
	.hero-latest-update { color: #70786f; font-size: 11px; }
	.hero-latest-sep { color: #a0a69f; }
	.hero-latest-article { display: inline; color: #244f3c; text-decoration: none; overflow-wrap: anywhere; }
	.hero-latest-article-label { font-weight: 700; color: #805d10; margin-right: 7px; }
	.hero-latest-article strong { font-weight: 700; }
	.hero-latest-arrow { margin-left: 5px; }
	.hero-latest-article:hover { text-decoration: underline; }
	@media (max-width: 640px) { .hero-latest-sep { display: none; } }

	/* ── First-time visitor intro ── */
	.first-visit-intro{display:grid;grid-template-columns:1.25fr .75fr;gap:1em;margin:0 0 2em;padding:1.15em 1.25em;border:1px solid #d9e4dc;border-left:4px solid var(--accent);border-radius:10px;background:#fbfdfb}
	.first-visit-kicker{display:inline-block;font-size:.68em;font-weight:800;letter-spacing:.08em;color:var(--accent-dark);margin-bottom:.35em}
	.first-visit-intro h2{border:0;padding:0;margin:0 0 .45em;font-size:1.05em}
	.first-visit-intro p{margin:0 0 .8em;font-size:.8em;line-height:1.75;color:rgb(var(--gray-dark))}
	.first-visit-main{font-size:.78em;font-weight:800;color:var(--accent);text-decoration:none}
	.first-visit-steps{display:grid;gap:.45em}
	.first-visit-step{display:flex;flex-direction:column;gap:.12em;padding:.55em .7em;border:1px solid #dde8dd;border-radius:7px;background:#fff;text-decoration:none}
	.first-visit-step strong{font-size:.76em;color:var(--accent-dark)}
	.first-visit-step span{font-size:.68em;color:rgb(var(--gray))}
	.first-visit-step:hover{background:#f3f8f4}
	@media(max-width:640px){.first-visit-intro{grid-template-columns:1fr}.first-visit-steps{grid-template-columns:1fr 1fr 1fr}.first-visit-step{padding:.5em}.first-visit-step span{font-size:.62em}}
	@media(max-width:420px){.first-visit-steps{grid-template-columns:1fr}}

	/* ── First-time visitor intro ── */
	.first-visit-intro{display:grid;grid-template-columns:1.25fr .75fr;gap:1em;margin:0 0 2em;padding:1.15em 1.25em;border:1px solid #d9e4dc;border-left:4px solid var(--accent);border-radius:10px;background:#fbfdfb}
	.first-visit-kicker{display:inline-block;font-size:.68em;font-weight:800;letter-spacing:.08em;color:var(--accent-dark);margin-bottom:.35em}
	.first-visit-intro h2{border:0;padding:0;margin:0 0 .45em;font-size:1.05em}
	.first-visit-intro p{margin:0 0 .8em;font-size:.8em;line-height:1.75;color:rgb(var(--gray-dark))}
	.first-visit-main{font-size:.78em;font-weight:800;color:var(--accent);text-decoration:none}
	.first-visit-steps{display:grid;gap:.45em}
	.first-visit-step{display:flex;flex-direction:column;gap:.12em;padding:.55em .7em;border:1px solid #dde8dd;border-radius:7px;background:#fff;text-decoration:none}
	.first-visit-step strong{font-size:.76em;color:var(--accent-dark)}
	.first-visit-step span{font-size:.68em;color:rgb(var(--gray))}
	.first-visit-step:hover{background:#f3f8f4}
	@media(max-width:640px){.first-visit-intro{grid-template-columns:1fr}.first-visit-steps{grid-template-columns:1fr 1fr 1fr}.first-visit-step{padding:.5em}.first-visit-step span{font-size:.62em}}
	@media(max-width:420px){.first-visit-steps{grid-template-columns:1fr}}

	/* ── 四コマコーナーへの入口 ── */
	.comics-teaser{display:grid;grid-template-columns:1fr auto;gap:1em;align-items:center;margin:0 0 2em;padding:1.15em 1.25em;border:1px solid #e3dcc4;border-left:4px solid #2f6b45;border-radius:10px;background:#fffdf6}
	.comics-teaser h2{border:0;padding:0;margin:0 0 .45em;font-size:1.05em}
	.comics-teaser p{margin:0 0 .8em;font-size:.8em;line-height:1.75;color:rgb(var(--gray-dark))}
	/* 絵は2話ぶんだけ見えて、右へスクロールすると過去の回が出てくる */
	.comics-teaser-strip{width:calc(140px * 2 + .7em)}
	.comics-teaser-list{list-style:none;margin:0 0 .5em;padding:0 0 .4em;display:flex;gap:.7em;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;scrollbar-width:thin;-webkit-overflow-scrolling:touch}
	.comics-teaser-list li{flex:0 0 140px;scroll-snap-align:start}
	.comics-teaser-list a{display:block;border-radius:6px;text-decoration:none}
	.comics-teaser-list a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
	.comics-teaser-list :global(img){display:block;width:100%;height:auto;object-fit:contain;border:1px solid #e3dcc4;border-radius:6px;background:#fff}
	.comics-teaser p.comics-teaser-latest{margin:0;font-size:.74em;line-height:1.6;color:rgb(var(--gray-dark))}
	.comics-teaser-label{display:inline-block;margin-right:.4em;padding:.05em .45em;border-radius:4px;background:#2f6b45;color:#fff;font-size:.9em;font-weight:800}
	.comics-teaser-latest a{color:var(--accent-dark);font-weight:800;text-decoration:none}
	.comics-teaser-latest a:hover,.comics-teaser-latest a:focus-visible{text-decoration:underline}
	.comics-teaser-date{display:block;color:rgb(var(--gray));font-weight:400}
	@media(max-width:640px){.comics-teaser{grid-template-columns:1fr}.comics-teaser-strip{width:100%}.comics-teaser-list li{flex:0 0 46%}}

	/* ── Asset Status ── */
	.asset-status {
		background: linear-gradient(135deg, #1a3a1c 0%, #0f2610 100%);
		border-radius: 12px;
		padding: 1.4em 1.5em;
		margin-bottom: 2em;
		color: #fff;
		position: relative;
		overflow: hidden;
	}
	.asset-status::before {
		content: '📈';
		position: absolute;
		right: -10px;
		bottom: -15px;
		font-size: 7em;
		opacity: 0.05;
		line-height: 1;
		pointer-events: none;
	}
	.asset-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1.1em;
		flex-wrap: wrap;
		gap: 0.4em;
	}
	.asset-launch-badge {
		background: rgba(126,217,87,0.18);
		border: 1px solid rgba(126,217,87,0.4);
		color: #a0e870;
		font-size: 0.72em;
		font-weight: 700;
		padding: 0.25em 0.8em;
		border-radius: 999px;
		letter-spacing: 0.04em;
	}
	.asset-account {
		font-size: 0.68em;
		color: rgba(255,255,255,0.4);
		font-weight: 600;
		letter-spacing: 0.06em;
	}
	.asset-main { margin-bottom: 1.2em; }
	.asset-amounts {
		display: flex;
		align-items: center;
		gap: 0;
		margin-bottom: 0.9em;
	}
	.asset-amt-block {
		flex: 1;
		min-width: 0;
	}
	.asset-amt-arrow {
		flex: 0 0 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0 2px;
	}
	.asset-amt-label {
		font-size: 0.6em;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(255,255,255,0.45);
		margin-bottom: 0.2em;
		white-space: nowrap;
	}
	.asset-amt-val { font-size: 1.05em; color: #fff; }
	.asset-amt-val strong { font-size: 1.35em; }
	.val-now strong  { color: #7ed957; }
	.val-mid strong  { color: #a0c8ff; }
	.val-goal strong { color: #e8b84b; }
	.asset-bar-wrap { }
	.asset-bar {
		background: rgba(255,255,255,0.1);
		border-radius: 6px;
		height: 28px;
		position: relative;
		overflow: visible;
		margin-bottom: 0.35em;
	}
	.asset-bar-fill {
		width: 25%;
		height: 100%;
		background: linear-gradient(90deg, #2c7a2e, #7ed957);
		border-radius: 6px;
		position: relative;
		display: flex;
		align-items: center;
		justify-content: flex-end;
	}
	.asset-bar-now {
		position: absolute;
		right: -30px;
		top: -2px;
		font-size: 0.5em;
		font-weight: 700;
		color: #7ed957;
		text-align: center;
		line-height: 1.2;
		white-space: nowrap;
	}
	.asset-bar-mid-marker {
		position: absolute;
		left: 50%;
		top: 0;
		height: 100%;
		width: 1px;
		background: rgba(160,200,255,0.45);
		pointer-events: none;
	}
	.asset-bar-mid-label {
		position: absolute;
		left: 4px;
		top: -1px;
		font-size: 0.48em;
		font-weight: 700;
		color: #a0c8ff;
		text-align: center;
		line-height: 1.2;
		white-space: nowrap;
	}
	.asset-bar-goal {
		position: absolute;
		right: 6px;
		top: 50%;
		transform: translateY(-50%);
		font-size: 0.6em;
		font-weight: 700;
		color: rgba(255,255,255,0.4);
	}
	.asset-bar-scale {
		display: flex;
		justify-content: space-between;
		font-size: 0.58em;
		color: rgba(255,255,255,0.3);
		padding: 0 2px;
	}
	.asset-now-sub { font-size: 0.72em; color: rgba(255,255,255,0.5); margin-top: 0.15em; }
	.asset-now-sub .pos { color: #7ed957; font-weight: 700; }
	.asset-chart-wrap {
		margin: 1em 0;
		border-radius: 8px;
		overflow: hidden;
		border: 1px solid rgba(255,255,255,0.1);
	}
	.asset-chart-img {
		width: 100%;
		display: block;
		border-radius: 0;
	}
	.asset-brand-note {
		font-size: 0.72em;
		color: rgba(255,255,255,0.6);
		margin: 0.8em 0 0.2em;
		padding-top: 0.7em;
		border-top: 1px solid rgba(255,255,255,0.1);
		font-weight: 600;
	}
	.asset-update-rule {
		font-size: 0.68em;
		color: rgba(255,255,255,0.45);
		margin: 0.3em 0 0.3em;
	}
	.asset-disclaimer {
		font-size: 0.65em;
		color: rgba(255,255,255,0.3);
		margin: 0;
		line-height: 1.5;
	}
	/* ── 2-column grid: watchlist + columns ── */
	.wl-col-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1em;
		margin-bottom: 2em;
		align-items: stretch;
	}
	.wl-col-grid > * { box-sizing: border-box; min-height: 0; }
	.wl-col-grid > .columns-section { display: flex; flex-direction: column; height: 0; min-height: 100%; overflow: hidden; }
	.wl-col-grid > .columns-section .columns-header { flex: 0 0 auto; }
	.wl-col-grid > .columns-section .columns-rows { flex: 1 1 0; height: 0; min-height: 0; overflow-y: auto; }
	/* 狭い画面では3列を維持できないので縦積みに戻す */
	@media (max-width: 1100px) {
		.hero-concept-wrap { max-width: 900px; gap: 8px; }
		.hero-concept-btn { flex: 1 1 calc(33.333% - 8px); max-width: 280px; min-height: 66px; padding: .42em .65em; }
		.hero-concept-text { flex: 1; overflow: visible; }
		.hero-concept-label { font-size: .68em; white-space: normal; line-height: 1.3; }
		.hero-concept-sub { font-size: .53em; white-space: normal; overflow: visible; text-overflow: clip; line-height: 1.35; }
	}
	@media (max-width: 640px) {
		.hero-concept-wrap { gap: 8px; }
		.hero-concept-btn { flex: 1 1 100%; max-width: 340px; padding: .48em .72em; align-items: flex-start; }
		.hero-concept-text { flex: 1; overflow: visible; }
		.hero-concept-label { font-size: .76em; white-space: normal; line-height: 1.35; }
		.hero-concept-sub { font-size: .58em; white-space: normal; overflow: visible; text-overflow: clip; line-height: 1.45; }
		.hero-concept-icon { font-size: 1.05em; margin-top: .08em; }
		.hero-concept-arrow { align-self: center; }
	}
	@media (max-width: 600px) {
		.wl-col-grid { grid-template-columns: 1fr; align-items: start; }
		.wl-col-grid > * { height: auto; }
		.wl-col-grid > .columns-section { display: block; overflow: hidden; }
		.wl-col-grid > .columns-section .columns-rows { height: 24em; max-height: 24em; }
	}

	/* ── Columns Section ── */
	.columns-section {
		min-width: 0;		margin-bottom: 0;
		border: 1px solid #dde3ec;
		border-radius: 10px;
		overflow: hidden;
	}
	.columns-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.55em 1em;
		background: #f0f4f8;
		border-bottom: 1px solid #dde3ec;
	}
	.columns-title {
		font-size: 0.78em;
		font-weight: 700;
		color: var(--accent-dark);
		letter-spacing: 0.04em;
	}
	.columns-all-link {
		font-size: 0.7em;
		color: var(--accent);
		font-weight: 600;
		text-decoration: none;
	}
	.columns-all-link:hover { color: var(--accent-dark); }
	.columns-rows {
		display: flex;
		flex-direction: column;
		height: auto;
		min-height: 0;
		overflow-y: auto;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: thin;
		scrollbar-color: #b8c4d0 transparent;
	}
	.columns-rows::-webkit-scrollbar { width: 4px; }
	.columns-rows::-webkit-scrollbar-track { background: transparent; }
	.columns-rows::-webkit-scrollbar-thumb { background: #c4ccd8; border-radius: 4px; }
	.col-row {
		display: flex;
		align-items: flex-start;
		gap: 0.45em;
		padding: 0.55em 0.8em;
		text-decoration: none;
		color: rgb(var(--gray-dark));
		border-bottom: 1px solid #f0f2f5;
		transition: background 0.12s;
		flex-wrap: wrap;
	}
	.col-row:last-child { border-bottom: none; }
	.col-row:hover { background: #f5f8fc; }
	.col-icon { font-size: 0.8em; flex-shrink: 0; margin-top: 0.15em; }
	.col-title {
		font-size: 0.76em;
		flex: 1;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		min-width: 0;
	}
	.col-date { display: none; }
	.col-arrow {
		font-size: 0.75em;
		color: var(--accent);
		font-weight: 700;
		flex-shrink: 0;
		align-self: center;
	}

	/* ── About Blog ── */
	.about-blog {
		margin-bottom: 2.5em;
		padding: 1.4em 1.2em;
		background: #f8faf8;
		border: 1px solid #dde8dd;
		border-radius: 10px;
	}
	.about-blog h2 {
		font-size: 1.1em;
		color: var(--accent-dark);
		border-left: 4px solid var(--accent);
		padding-left: 0.6em;
		margin: 0 0 1em;
	}
	.about-grid {
		display: flex;
		flex-direction: column;
		gap: 0.85em;
		margin-bottom: 0.9em;
	}
	.about-item {
		display: flex;
		gap: 0.75em;
		align-items: flex-start;
	}
	.about-icon {
		font-size: 1.3em;
		flex-shrink: 0;
		margin-top: 0.05em;
	}
	.about-label {
		font-size: 0.7em;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--accent-dark);
		text-transform: uppercase;
		margin-bottom: 0.2em;
	}
	.about-text {
		font-size: 0.85em;
		color: rgb(var(--gray-dark));
		line-height: 1.65;
	}
	.about-note-inline {
		font-size: 0.9em;
		color: rgb(var(--gray));
		display: block;
		margin-top: 0.4em;
		line-height: 1.6;
	}
	.about-note {
		font-size: 0.76em;
		color: rgb(var(--gray));
		margin: 0;
		padding-top: 0.8em;
		border-top: 1px dashed #ccd8cc;
	}
	.hero {
		text-align: center;
		padding: 3em 1em 2em;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 2em;
		position: relative;
		overflow: hidden;
		background: linear-gradient(180deg, #f4fbf7 0%, #fbfdfb 58%, #ffffff 100%);
	}
	.hero-visual {
		margin: -1.7em auto 1.4em;
		max-width: 1120px;
		border-radius: 18px;
		overflow: hidden;
		box-shadow: 0 14px 34px rgba(24, 56, 45, 0.14);
		border: 1px solid rgba(53, 103, 76, 0.18);
	}
	.hero-visual { position: relative; }
	.hero-visual img { display:block; width:100%; height:auto; }
	.hero-play {
		position: absolute;
		left: 3%;
		top: 13%;
		transform: translateY(-50%);
		width: max(54px, 7.6%);
		padding: 0;
		border: none;
		background: none;
		cursor: pointer;
	}
	.hero-play-circle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		aspect-ratio: 1;
		border-radius: 50%;
		border: 3px solid #fff;
		background: rgba(20, 45, 33, 0.38);
		color: #fff;
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.28);
		transition: background 0.15s ease, transform 0.15s ease;
	}
	.hero-play svg { width: 42%; height: auto; margin-left: 8%; filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.6)); }
	.hero-play-label {
		position: absolute;
		top: calc(100% + 5px);
		left: 0;
		padding: 0.15em 0.6em;
		border-radius: 999px;
		background: rgba(20, 45, 33, 0.38);
		font-size: clamp(10px, 1.05vw, 13px);
		font-weight: 800;
		color: #fff;
		white-space: nowrap;
		text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8), 0 0 6px rgba(0, 0, 0, 0.55);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.22);
	}
	.hero-play-members {
		left: auto;
		right: 3%;
		top: 85%;
	}
	.hero-play-members .hero-play-label {
		top: auto;
		bottom: calc(100% + 5px);
		left: auto;
		right: 0;
	}
	.hero-play:hover .hero-play-circle,
	.hero-play:focus-visible .hero-play-circle {
		background: rgba(20, 45, 33, 0.62);
		transform: scale(1.08);
	}
	.hero-badge {
		display: inline-block;
		background: var(--accent-light);
		color: var(--accent-dark);
		font-weight: bold;
		font-size: 0.85em;
		padding: 0.3em 1em;
		border-radius: 999px;
		margin-bottom: 1em;
	}
	.hero h1 {
		font-size: clamp(1.9rem, 2.55vw, 2.7rem);
		line-height: 1.2;
		margin: 0 0 0.5em;
		letter-spacing: 0.01em;
		white-space: nowrap;
	}
	.hero-desc {
		color: rgb(var(--gray));
		font-size: clamp(0.82rem, 1.05vw, 1.05rem);
		max-width: none;
		margin: 0 auto 1.25em;
		line-height: 1.55;
		white-space: nowrap;
	}
	.hero-desc-mobile { display: none; }
	.hero-tags {
		display: flex;
		flex-wrap: nowrap;
		gap: 0.3em;
		justify-content: center;
		max-width: 100%;
	}
	.tag {
		background: var(--accent-light);
		color: var(--accent-dark);
		font-size: 0.7em;
		padding: 0.22em 0.55em;
		border-radius: 4px;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		transition: background 0.15s, color 0.15s;
	}
	.tag:hover { background: var(--accent); color: #fff; }
	.tag-emoji { margin-right: 0.25em; font-size: 1em; }
	@media (max-width: 680px) {
		.hero-tags { flex-wrap: wrap; }
	}
	.method-note {
		display: flex;
		gap: 0.6em;
		align-items: flex-start;
		background: #f4f6f9;
		border: 1px solid #dde1e8;
		border-left: 3px solid var(--accent);
		border-radius: 6px;
		padding: 0.65em 0.9em;
		margin-bottom: 2em;
		font-size: 0.82em;
		color: rgb(var(--gray-dark));
		line-height: 1.6;
	}
	.method-icon { font-size: 1.1em; flex-shrink: 0; margin-top: 0.1em; }
	.method-note p { margin: 0; }
	.method-note a { color: var(--accent); text-decoration: none; font-weight: 600; }
	.method-note a:hover { color: var(--accent-dark); }

	.posts-section, .members-teaser {
		margin-bottom: 3em;
	}
	h2 {
		font-size: 1.3em;
		color: var(--accent-dark);
		border-left: 4px solid var(--accent);
		padding-left: 0.6em;
		margin-bottom: 1em;
	}
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0 0 1em;
		max-height: calc(3 * 5em);
		overflow-y: auto;
		scrollbar-width: thin;
		scrollbar-color: rgba(0,0,0,0.15) transparent;
		border-radius: 6px;
	}
	.post-list::-webkit-scrollbar { width: 4px; }
	.post-list::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.15); border-radius: 4px; }
	.post-list li {
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.post-list a {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.8em 0.4em;
		text-decoration: none;
		color: rgb(var(--gray-dark));
		gap: 1em;
	}
	.post-list a:hover {
		color: var(--accent-dark);
	}
	.post-title {
		flex: 1;
	}
	.post-date {
		font-size: 0.8em;
		color: rgb(var(--gray));
		white-space: nowrap;
	}
	.all-posts-link {
		display: inline-block;
		color: var(--accent);
		font-weight: 600;
		text-decoration: none;
		font-size: 0.95em;
	}
	.all-posts-link:hover {
		color: var(--accent-dark);
