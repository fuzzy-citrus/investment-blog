---
import Comments from '../components/Comments.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const allPosts = (await getCollection('blog'))
	.filter(p => !p.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const posts = allPosts.slice(0, 10);
// コラムは新着順（pubDate降順）で表示
const columns = allPosts.filter(p => !p.data.stockCard);

// ヒーローに表示する最新更新日（＝最新公開記事の pubDate）
const latestUpdate = allPosts[0]?.data.pubDate;
const latestUpdateLabel = latestUpdate?.toLocaleDateString('ja-JP', {
	timeZone: 'Asia/Tokyo',
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});

// 📋 紹介銘柄ウォッチリスト：stockCard.rating から自動生成
// draft は allPosts の時点で除外済み → 在庫記事は公開した瞬間に自動で載る（手動追加は不要）
const RATING_ORDER = ['A++', 'A+', 'A', 'A-', 'B++', 'B+', 'B'];
const RATING_CLASS: Record<string, string> = {
	'A++': 'rA-plus-plus',
	'A+': 'rA-plus',
	'A': 'rA',
	'A-': 'rA-minus',
	'B++': 'rB-plus-plus',
	'B+': 'rB-plus',
	'B': 'rB',
};
const watchlist = allPosts
	.filter((p) => p.data.stockCard?.rating)
	.map((p) => {
		const sc = p.data.stockCard!;
		const rating = sc.rating!;
		return {
			href: `/blog/${p.id}/`,
			ratingClass: RATING_CLASS[rating],
			ratingBase: rating.charAt(0),
			ratingSup: rating.slice(1).replace('-', '−'),
			name: sc.shortName ?? sc.companyName,
			ticker: sc.ticker,
			rank: RATING_ORDER.indexOf(rating),
			pub: p.data.pubDate.valueOf(),
		};
	})
	.sort((a, b) => (a.rank !== b.rank ? a.rank - b.rank : b.pub - a.pub));
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-badge">🏢 バリュー商会</div>
				<h1>沼田課長の投資記録</h1>
				<p class="hero-desc">〜 低金利 × 中レバレッジ × 高安全域 〜</p>
				<div class="hero-tags">
					<a class="tag" href="/map#asset-value"><span class="tag-emoji">🦦</span>資産バリュー</a>
					<a class="tag" href="/map#moat"><span class="tag-emoji">🦫</span>ニッチ独占</a>
					<a class="tag" href="/map#tob-event"><span class="tag-emoji">🐊</span>TOB発掘</a>
					<a class="tag" href="/map#risk-leverage"><span class="tag-emoji">🧓</span>野村流</a>
					<a class="tag" href="/map#philosophy"><span class="tag-emoji">🧑‍💼</span>投資哲学</a>
					<a class="tag" href="/map#income"><span class="tag-emoji">🐝</span>高配当・増配</a>
				</div>
				<div class="hero-concept-wrap">
					<a href="/concept/" class="hero-concept-btn">
						<span class="hero-concept-icon">💎</span>
						<span class="hero-concept-text">
							<span class="hero-concept-label">経営コンセプト</span>
							<span class="hero-concept-sub">投資哲学と買い方</span>
						</span>
						<span class="hero-concept-arrow">→</span>
					</a>
					<a href="/holdings.html" class="hero-concept-btn">
						<span class="hero-concept-icon">📊</span>
						<span class="hero-concept-text">
							<span class="hero-concept-label">保有銘柄と損益</span>
							<span class="hero-concept-sub">集計 2026年7月27日</span>
						</span>
						<span class="hero-concept-arrow">→</span>
					</a>
					<a href="/margin/" class="hero-concept-btn">
						<span class="hero-concept-icon">🧓</span>
						<span class="hero-concept-text">
							<span class="hero-concept-label">野村流信用錬金術</span>
							<span class="hero-concept-sub">低金利レバレッジ</span>
						</span>
						<span class="hero-concept-arrow">→</span>
					</a>
					<a href="/value/" class="hero-concept-btn is-new">
						<span class="hero-concept-icon">🦦</span>
						<span class="hero-concept-text">
							<span class="hero-concept-new">NEW</span>
							<span class="hero-concept-label">バリュー株の魅力</span>
							<span class="hero-concept-sub">割安株投資の体系</span>
						</span>
						<span class="hero-concept-arrow">→</span>
					</a>
				</div>
				{latestUpdateLabel && (
					<p class="hero-updated">📅 最終更新：{latestUpdateLabel}</p>
				)}
			</section>

			<div class="wl-col-grid">

				<section class="watchlist">
					<div class="watchlist-header">
						<span class="watchlist-title">📋 紹介銘柄</span>
						<a href="/blog/" class="columns-all-link">すべて見る →</a>
					</div>
					<div class="watchlist-rows">
						{watchlist.map((s) => (
							<a href={s.href} class="wl-row">
								<span class={`wl-rating ${s.ratingClass}`}>{s.ratingBase}{s.ratingSup && <sup>{s.ratingSup}</sup>}</span>
								<span class="wl-name">{s.name} <span class="wl-code">{s.ticker}</span></span>
								<span class="wl-arrow">→</span>
							</a>
						))}
					</div>
				</section>

				<section class="columns-section">
					<div class="columns-header">
						<span class="columns-title">📝 投資コラム</span>
						<a href="/blog/?type=column" class="columns-all-link">すべて見る →</a>
					</div>
					<div class="columns-rows">
						{columns.map((post) => (
							<a href={`/blog/${post.id}/`} class="col-row">
								<span class="col-icon">📖</span>
								<span class="col-title">{post.data.title}</span>
								<span class="col-date"><FormattedDate date={post.data.pubDate} /></span>
								<span class="col-arrow">→</span>
							</a>
						))}
					</div>
				</section>

			</div>

			<div class="method-note">
				<span class="method-icon">🤖</span>
				<div>
					<p>掲載している「期待株価」は、複数AIによるベア・ベース・ブル3ケースの確率加重平均です。<strong>今すぐ株価が収束する想定ではなく、3年程度保有した場合の到達目安</strong>です。参考値であり投資勧誘ではありません。</p>
					<p>不動産含み益は「有価証券報告書に記載の物件所在地・地積・取得時期」と「国土交通省の公示価格データ」を照合し、AIによるエリア別地価分析で算出しています。<strong>実際の物件情報ベース</strong>なので精度は相応にあるはずです。ブレはあります。</p>
				</div>
			</div>

			<section class="posts-section">
				<h2>最新記事</h2>
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<span class="post-title">{post.data.title}</span>
								<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
							</a>
						</li>
					))}
				</ul>
				<a href="/blog" class="all-posts-link">すべての記事を見る →</a>
			</section>

			<section class="members-teaser">
				<h2>メンバー紹介</h2>
				<p>バリュー商会には個性豊かな分析担当がいます</p>
				<div class="member-emojis">
					<a href="/characters#machibuse" class="member-item">
						<span title="待伏 静江">🐊</span>
						<span class="member-role">TOB発掘</span>
					</a>
					<a href="/characters#kawachi" class="member-item">
						<span title="河内 拾造">🦦</span>
						<span class="member-role">割安発掘</span>
					</a>
					<a href="/characters#hotta" class="member-item">
						<span title="堀田 独占">🦫</span>
						<span class="member-role">競合優位性</span>
					</a>
					<a href="/characters#yomi" class="member-item">
						<span title="夜見 賢三">🦉</span>
						<span class="member-role">財務分析</span>
					</a>
					<a href="/characters#yuda" class="member-item">
						<span title="優田 雅代">🦩</span>
						<span class="member-role">株主優待</span>
					</a>
					<a href="/characters#hanaoka" class="member-item">
						<span title="花岡 利次郎">🐝</span>
						<span class="member-role">高配当</span>
					</a>
					<a href="/characters#morita" class="member-item">
						<span title="守田 退三">🦞</span>
						<span class="member-role">リスク管理</span>
					</a>
					<a href="/characters#sumida" class="member-item">
						<span title="墨田 検二">🦑</span>
						<span class="member-role">AIチェック</span>
					</a>
				</div>
				<a href="/org" class="all-posts-link">組織図で見る →</a>
			</section>

			</main>
		<Footer />

	</body>
</html>

<style>
	/* ── Hero Concept Button ── */
	.hero-concept-wrap {
		margin-top: 1.1em;
		display: flex;
		gap: 6px;
		justify-content: center;
		flex-wrap: wrap;
		max-width: 940px;
		margin-inline: auto;
	}
	.hero-concept-btn {
		flex: 1 1 0;
		box-sizing: border-box;
		min-width: 0;
		max-width: 172px;
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.22em;
		background: rgba(255,255,255,0.92);
		border: 1.5px solid rgba(232,184,75,0.7);
		border-radius: 8px;
		padding: 0.28em 0.4em 0.28em 0.38em;
		text-decoration: none;
		box-shadow: 0 2px 8px rgba(0,0,0,0.08);
		transition: background 0.15s, transform 0.1s;
	}
	.hero-concept-btn:hover {
		background: #fff;
		transform: translateY(-1px);
		border-color: #e8b84b;
	}
	.hero-concept-icon { font-size: 0.82em; flex-shrink: 0; }
	.hero-concept-text {
		display: flex;
		flex-direction: column;
		gap: 0.05em;
		min-width: 0;
		overflow: hidden;
	}
	.hero-concept-label {
		font-size: 0.63em;
		white-space: nowrap;
		font-weight: 900;
		color: #1a3a5c;
		letter-spacing: 0.02em;
	}
	.hero-concept-sub {
		font-size: 0.49em;
		color: #888;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	/* 新設ページの目印。ボタンの枠外に出す */
	.hero-concept-new {
		position: absolute;
		top: -9px;
		right: -7px;
		background: #e0453a;
		color: #fff;
		font-size: 0.5em;
		font-weight: 900;
		letter-spacing: 0.08em;
		padding: 2px 7px;
		border-radius: 999px;
		box-shadow: 0 2px 6px rgba(224,69,58,0.4);
		z-index: 2;
	}
	.hero-concept-arrow {
		font-size: 0.58em;
		flex-shrink: 0;
		font-weight: 700;
		color: #b8860b;
	}
	.hero-updated {
		margin: 0.8em auto 0;
		font-size: 0.68em;
		color: rgb(var(--gray));
		letter-spacing: 0.04em;
		text-align: center;
	}

	/* ── Asset Status ── */
	.asset-status {
		background: linear-gradient(135deg, #1a3a1c 0%, #0f2610 100%);
		border-radius: 12px;
		padding: 1.4em 1.5em;
		margin-bottom: 2em;
		color: #fff;
		position: relative;
		overflow: hidden;
	}
	.asset-status::before {
		content: '📈';
		position: absolute;
		right: -10px;
		bottom: -15px;
		font-size: 7em;
		opacity: 0.05;
		line-height: 1;
		pointer-events: none;
	}
	.asset-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1.1em;
		flex-wrap: wrap;
		gap: 0.4em;
	}
	.asset-launch-badge {
		background: rgba(126,217,87,0.18);
		border: 1px solid rgba(126,217,87,0.4);
		color: #a0e870;
		font-size: 0.72em;
		font-weight: 700;
		padding: 0.25em 0.8em;
		border-radius: 999px;
		letter-spacing: 0.04em;
	}
	.asset-account {
		font-size: 0.68em;
		color: rgba(255,255,255,0.4);
		font-weight: 600;
		letter-spacing: 0.06em;
	}
	.asset-main { margin-bottom: 1.2em; }
	.asset-amounts {
		display: flex;
		align-items: center;
		gap: 0;
		margin-bottom: 0.9em;
	}
	.asset-amt-block {
		flex: 1;
		min-width: 0;
	}
	.asset-amt-arrow {
		flex: 0 0 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0 2px;
	}
	.asset-amt-label {
		font-size: 0.6em;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(255,255,255,0.45);
		margin-bottom: 0.2em;
		white-space: nowrap;
	}
	.asset-amt-val { font-size: 1.05em; color: #fff; }
	.asset-amt-val strong { font-size: 1.35em; }
	.val-now strong  { color: #7ed957; }
	.val-mid strong  { color: #a0c8ff; }
	.val-goal strong { color: #e8b84b; }
	.asset-bar-wrap { }
	.asset-bar {
		background: rgba(255,255,255,0.1);
		border-radius: 6px;
		height: 28px;
		position: relative;
		overflow: visible;
		margin-bottom: 0.35em;
	}
	.asset-bar-fill {
		width: 25%;
		height: 100%;
		background: linear-gradient(90deg, #2c7a2e, #7ed957);
		border-radius: 6px;
		position: relative;
		display: flex;
		align-items: center;
		justify-content: flex-end;
	}
	.asset-bar-now {
		position: absolute;
		right: -30px;
		top: -2px;
		font-size: 0.5em;
		font-weight: 700;
		color: #7ed957;
		text-align: center;
		line-height: 1.2;
		white-space: nowrap;
	}
	.asset-bar-mid-marker {
		position: absolute;
		left: 50%;
		top: 0;
		height: 100%;
		width: 1px;
		background: rgba(160,200,255,0.45);
		pointer-events: none;
	}
	.asset-bar-mid-label {
		position: absolute;
		left: 4px;
		top: -1px;
		font-size: 0.48em;
		font-weight: 700;
		color: #a0c8ff;
		text-align: center;
		line-height: 1.2;
		white-space: nowrap;
	}
	.asset-bar-goal {
		position: absolute;
		right: 6px;
		top: 50%;
		transform: translateY(-50%);
		font-size: 0.6em;
		font-weight: 700;
		color: rgba(255,255,255,0.4);
	}
	.asset-bar-scale {
		display: flex;
		justify-content: space-between;
		font-size: 0.58em;
		color: rgba(255,255,255,0.3);
		padding: 0 2px;
	}
	.asset-now-sub { font-size: 0.72em; color: rgba(255,255,255,0.5); margin-top: 0.15em; }
	.asset-now-sub .pos { color: #7ed957; font-weight: 700; }
	.asset-chart-wrap {
		margin: 1em 0;
		border-radius: 8px;
		overflow: hidden;
		border: 1px solid rgba(255,255,255,0.1);
	}
	.asset-chart-img {
		width: 100%;
		display: block;
		border-radius: 0;
	}
	.asset-brand-note {
		font-size: 0.72em;
		color: rgba(255,255,255,0.6);
		margin: 0.8em 0 0.2em;
		padding-top: 0.7em;
		border-top: 1px solid rgba(255,255,255,0.1);
		font-weight: 600;
	}
	.asset-update-rule {
		font-size: 0.68em;
		color: rgba(255,255,255,0.45);
		margin: 0.3em 0 0.3em;
	}
	.asset-disclaimer {
		font-size: 0.65em;
		color: rgba(255,255,255,0.3);
		margin: 0;
		line-height: 1.5;
	}
	/* ── 2-column grid: watchlist + columns ── */
	.wl-col-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1em;
		margin-bottom: 2em;
		align-items: start;
	}
	/* 狭い画面では3列を維持できないので縦積みに戻す */
	@media (max-width: 640px) {
		.hero-concept-wrap { gap: 8px; }
		.hero-concept-btn {
			flex: 1 1 100%;
			max-width: 320px;
			padding: 0.4em 0.8em 0.4em 0.65em;
		}
		.hero-concept-label { font-size: 0.8em; }
		.hero-concept-sub { font-size: 0.62em; }
		.hero-concept-icon { font-size: 1.1em; }
	}
	@media (max-width: 600px) {
		.wl-col-grid { grid-template-columns: 1fr; }
	}

	/* ── Watchlist ── */
	.watchlist {
		margin-bottom: 0;
		border: 1px solid #dde3ec;
		border-radius: 10px;
		overflow: hidden;
	}
	.watchlist-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.55em 1em;
		background: #f0f4f0;
		border-bottom: 1px solid #dde3ec;
	}
	.watchlist-title {
		font-size: 0.78em;
		font-weight: 700;
		color: var(--accent-dark);
		letter-spacing: 0.04em;
	}
	.watchlist-updated {
		font-size: 0.65em;
		color: rgb(var(--gray));
	}
	.watchlist-rows {
		display: flex;
		flex-direction: column;
		max-height: 9.2em;
		overflow-y: auto;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: thin;
		scrollbar-color: #b8c8b8 transparent;
	}
	.watchlist-rows::-webkit-scrollbar { width: 4px; }
	.watchlist-rows::-webkit-scrollbar-track { background: transparent; }
	.watchlist-rows::-webkit-scrollbar-thumb { background: #c4d4c4; border-radius: 4px; }
	.wl-row {
		display: flex;
		align-items: center;
		gap: 0.6em;
		padding: 0.5em 0.8em;
		text-decoration: none;
		color: rgb(var(--gray-dark));
		border-bottom: 1px solid #f0f2f5;
		transition: background 0.12s;
	}
	.wl-row:last-child { border-bottom: none; }
	.wl-row:hover { background: #f5faf5; }
	.wl-rating {
		font-size: 0.78em;
		font-weight: 800;
		min-width: 2.4em;
		text-align: center;
		padding: 0.15em 0.5em;
		border-radius: 4px;
		flex-shrink: 0;
		letter-spacing: 0.02em;
	}
	.wl-rating sup { font-size: 0.7em; }
	.rA-plus-plus { background: linear-gradient(135deg, #ffe680 0%, #f0a830 100%); color: #5a3a00; border: 1px solid #d89020; box-shadow: 0 0 6px rgba(240,168,48,0.5); font-weight: 900; }
	.rA-plus  { background: #fff4cc; color: #8a6a00; border: 1px solid #e8c840; }
	.rA       { background: #e6f5ee; color: var(--accent-dark); border: 1px solid #a8d8bc; }
	.rA-minus { background: #eef5ee; color: #3a7a58; border: 1px solid #b8d8c4; }
	.rB-plus-plus { background: #e7f0f7; color: #2f4a72; border: 1px solid #a3bbd6; font-weight: 700; }
	.rB       { background: #eef2f8; color: #4a5a80; border: 1px solid #b8c4dc; }
	.rB-plus  { background: #edf2f8; color: #3a4e78; border: 1px solid #aabcd8; }
	.wl-name {
		font-size: 0.85em;
		font-weight: 700;
		min-width: 120px;
		flex-shrink: 0;
	}
	.wl-code {
		font-size: 0.8em;
		font-weight: 400;
		color: rgb(var(--gray));
		margin-left: 0.3em;
	}
	.wl-status {
		font-size: 0.82em;
		color: rgb(var(--gray-dark));
		flex: 1;
		display: flex;
		align-items: center;
		gap: 0.45em;
	}
	.wl-dot {
		width: 7px; height: 7px;
		border-radius: 50%;
		flex-shrink: 0;
	}
	.wl-dot.green  { background: #3cb86a; }
