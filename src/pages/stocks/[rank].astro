---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import StockRankSummary from '../../components/StockRankSummary.astro';
import { stockRanks } from '../../data/stockRanks';
import { SITE_TITLE } from '../../consts';
export function getStaticPaths() {
  return stockRanks.map(({ rating, slug }) => ({ params: { rank: slug }, props: { rating } }));
}
const { rating } = Astro.props;
const posts = (await getCollection('blog')).filter(p => !p.data.draft);
const items = posts.filter(p => p.data.stockCard?.rating === rating)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const investmentTypes = ['資産型', '本業型', 'ニッチトップ型', 'インカム型', 'イベント型', '複合型', '分類未設定'];
const assetTypes = ['現預金', '有価証券', '土地・不動産', 'ネットキャッシュ', 'その他資産'] as const;
---
<!doctype html>
<html lang="ja">
  <head><BaseHead title={`${rating}の紹介銘柄 | ${SITE_TITLE}`} description={`${rating}ランクの紹介銘柄一覧。投資タイプと資産の中身から絞り込めます。`} /></head>
  <body>
    <Header />
    <main>
      <a class="home-link" href="/">← ホーム</a>
      <h1>{rating}の紹介銘柄</h1>
      <StockRankSummary posts={posts} currentRank={rating} />
      <section class="rank-panel" aria-label={`${rating}の銘柄一覧`}>
        <p class="panel-heading">{rating}・{items.length}銘柄 <span>公開日の新しい順</span></p>
          <div class="filters" hidden>
            {[
              { key: 'investment', label: '投資タイプ', options: investmentTypes.map(value => ({ value, count: items.filter(p => (p.data.stockCard!.investmentType ?? '分類未設定') === value).length })) },
              { key: 'asset', label: '資産の中身', options: assetTypes.map(value => ({ value, count: items.filter(p => p.data.stockCard!.assetTypes?.includes(value)).length })) },
            ].map(({ key, label, options }) => (
              <div class="filter-group" role="group" aria-label={label} data-filter={key}>
                <p class="filter-label">{label}</p>
                <div class="filter-chips">
                  <button type="button" class="filter-chip" data-value="" aria-pressed="true">すべて {items.length}</button>
                  {options.filter(option => option.count > 0).map(({ value, count }) => (
                    <button type="button" class="filter-chip" data-value={value} aria-pressed="false">{value} {count}</button>
                  ))}
                </div>
              </div>
            ))}
            <p class="filter-help">件数はランク内の総数です。投資タイプと資産は両方の条件で絞り込みます。選択中のチップをもう一度押すと解除できます。</p>
          </div>
          {items.length === 0 ? <p class="empty">このランクの紹介銘柄はまだありません。</p> : (
            <ul>
              {items.map(post => {
                const stock = post.data.stockCard!;
                return <li data-investment={stock.investmentType ?? '分類未設定'} data-assets={JSON.stringify(stock.assetTypes ?? [])}><a class="stock-row" href={`/blog/${post.id}/`}>
                  <span class="stock-name">{stock.shortName ?? stock.companyName}<span class="code">{stock.ticker}</span></span>
                  <span class="tags">
                    <span class:list={['type', { unset: !stock.investmentType }]}>{stock.investmentType ?? '分類未設定'}</span>
                    {(stock.assetTypes ?? []).map(tag => <span class="asset">{tag}</span>)}
                  </span>
                  <span class="arrow" aria-hidden="true">→</span>
                </a></li>;
              })}
            </ul>
          )}
          <p class="empty filter-result" role="status" aria-live="polite" aria-atomic="true" hidden></p>

      </section>
    </main>
    <Footer />
  </body>
</html>
<script>
  document.querySelectorAll<HTMLElement>('.rank-panel').forEach(panel => {
    const filters = panel.querySelector<HTMLElement>('.filters')!;
    const rows = [...panel.querySelectorAll<HTMLLIElement>('li[data-investment]')];
    const result = panel.querySelector<HTMLElement>('.filter-result')!;
    const selected: Record<string, string> = { investment: '', asset: '' };
    filters.querySelectorAll<HTMLElement>('.filter-group').forEach(group => {
      const key = group.dataset.filter!;
      group.querySelectorAll<HTMLButtonElement>('button').forEach(chip => {
        chip.addEventListener('click', () => {
          selected[key] = selected[key] === chip.dataset.value ? '' : chip.dataset.value!;
          group.querySelectorAll<HTMLButtonElement>('button').forEach(option => {
            option.setAttribute('aria-pressed', String(option.dataset.value === selected[key]));
          });
          let visible = 0;
          rows.forEach(row => {
            const assets: string[] = JSON.parse(row.dataset.assets!);
            row.hidden = !((!selected.investment || row.dataset.investment === selected.investment)
              && (!selected.asset || assets.includes(selected.asset)));
            if (!row.hidden) visible++;
          });
          result.hidden = false;
          result.textContent = visible === 0 ? '該当する銘柄はありません' : `${visible}銘柄を表示`;
        });
      });
    });
    filters.hidden = false;
  });
</script>
<style>
  main { width: 900px; max-width: calc(100% - 32px); margin: 32px auto; }
  h1 { font-size: clamp(24px, 5vw, 34px); margin: 18px 0; color: #244f3c; }
  .home-link { font-size: 14px; color: #285d46; }
  .rank-panel { margin-top: 24px; border: 1px solid #d9e3dc; border-radius: 12px; overflow: hidden; }
  [hidden] { display: none !important; }
  a:focus-visible, button:focus-visible { outline: 3px solid #247d60; outline-offset: -3px; }
  .filters { padding: 12px; border-bottom: 1px solid #e6ebe7; min-width: 0; }
  .filter-group + .filter-group { margin-top: 10px; }
  .filter-label { margin: 0 0 4px; font-size: 12px; font-weight: 700; color: #314b3c; }
  .filter-chips { display: flex; gap: 6px; overflow-x: auto; padding: 5px 4px; }
  .filter-chip { flex: 0 0 auto; min-height: 44px; padding: 7px 12px; border: 1px solid #a5b9ad; border-radius: 999px; background: #fff; color: #314b3c; font: inherit; font-size: 13px; cursor: pointer; }
  .filter-chip[aria-pressed='true'] { background: #285c3e; border-color: #285c3e; color: #fff; font-weight: 700; }
  .filter-chip:hover { border-color: #247d60; }
  .filter-help { margin: 8px 0 0; font-size: 12px; line-height: 1.7; color: #637067; }
  .panel-heading { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 0; padding: 10px 12px; background: #f7f9f7; font-size: 15px; font-weight: 700; color: #314b3c; }
  .panel-heading span { font-size: 12px; font-weight: 400; color: #637067; }
  ul { padding: 0; margin: 0; list-style: none; }
  li + li { border-top: 1px solid #e6ebe7; }
  .stock-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; padding: 14px 12px; color: #253e30; text-decoration: none; }
  .stock-row:hover { background: #f5f9f5; }
  .stock-row:focus-visible { outline-offset: -3px; }
  .stock-name { font-size: 16px; font-weight: 700; line-height: 1.5; overflow-wrap: anywhere; }
  .code { display: inline-block; margin-left: 9px; font-size: 13px; font-weight: 400; color: #626e66; }
  .tags { grid-column: 1; display: flex; flex-wrap: wrap; gap: 6px; }
  .type, .asset { font-size: 12px; line-height: 1.5; border-radius: 999px; padding: 3px 9px; }
  .type { background: #e9f3ed; color: #285c3e; font-weight: 700; }
  .asset { background: #fff4d9; color: #725814; }
  .unset { background: #f0f1f2; color: #666d71; font-weight: 400; }
  .arrow { grid-column: 2; grid-row: 1 / 3; align-self: center; color: #527561; }
  .empty { font-size: 14px; padding: 12px; margin: 0; color: #637067; }
</style>
