---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const firstReads = [
	['/value/', '🦦', 'バリュー株の魅力', '資産性と収益性の全体像から入る'],
	['/blog/how-to-find-net-net-japan/', '🔎', 'ネットネット株の探し方', '数字の安さを発掘手順へ落とす'],
	['/blog/low-payout-internal-compounding/', '♻️', '低配当性向と社内複利', '還元の少なさを別の物差しで検証する'],
	['/blog/activist-front-running-02/', '🐊', '大量保有報告書の読み方', '外圧を一次資料から追う'],
	['/blog/scorecard-45-stocks-2026q3/', '📋', '紹介銘柄の通信簿', '紹介後を全件で答え合わせする'],
];
const paths = [
	['/map#asset-value', '🦦', '資産バリュー', '現金・有価証券・土地など、値段の裏側を確認する'],
	['/map#moat', '🦫', 'ニッチトップ', '供給制約や切替コストなど、続きやすい強みを見る'],
	['/map#tob-event', '🐊', 'TOB・再編', '資本政策、大量保有報告書、MBOなどを追う'],
	['/map#risk-leverage', '🦞', '投資実務', '資金管理、信用維持率、暴落時の余力を確認する'],
];
---
<!doctype html>
<html lang="ja">
<head>
	<BaseHead title="初めての方へ｜沼底バリュー商会" description="沼底バリュー商会を初めて読む方向けに、投資哲学、代表記事、公開ポートフォリオ、通信簿、有料noteの役割を順番に案内します。" />
</head><body>
	<Header />
	<main>
		<section class="hero">
			<span class="eyebrow">START HERE</span>
			<h1>初めての方へ</h1>
			<p class="lead">沼底バリュー商会は、<strong>安い理由を数字と一次資料で確かめる</strong>投資ブログです。個別銘柄だけでなく、資産・事業・外圧・資金管理まで分けて検証し、紹介後の値動きや訂正も残しています。</p>
			<div class="promise"><strong>このサイトの約束</strong><br />無料ブログでは個別分析と答え合わせを公開し、noteでは銘柄そのものではなく、再現できる手順・判断基準・チェックリストを扱います。</div>
		</section>
		<section>
			<h2><span>1</span> まず5分で全体像</h2>
			<div class="panel"><div><h3>「安い」だけで終わらせません</h3><p>資産性、収益性、カタリスト、流動性、待つ間の報酬まで分けて見ます。</p></div><div class="actions"><a class="primary" href="/value/">バリュー株の体系を見る →</a><a href="/concept/">投資哲学を見る →</a></div></div>
		</section>
		<section>
			<h2><span>2</span> 興味のある入口から読む</h2>
			<div class="grid paths">{paths.map(([href, icon, title, desc]) => <a href={href} class="card"><b class="icon">{icon}</b><strong>{title}</strong><p>{desc}</p><em>記事を探す →</em></a>)}</div>
		</section>
		<section>
			<h2><span>3</span> 最初に読む無料記事 5本</h2>
			<p class="sub">個別銘柄の結論だけでなく、「どう考えているか」が分かる記事を選びました。</p>
			<div class="reads">{firstReads.map(([href, icon, title, desc], i) => <a href={href} class="read"><span>{String(i + 1).padStart(2, '0')}</span><b>{icon}</b><div><strong>{title}</strong><small>{desc}</small></div><em>→</em></a>)}</div>
		</section>		<section>
			<h2><span>4</span> 結果と失敗も確認する</h2>
			<div class="grid evidence">
				<a href="/holdings" class="evidence-card"><strong>📊 最新ポートフォリオ</strong><p>保有銘柄と売買記録を公開しています。記事だけでなく、実際の運用も確認できます。</p><b>現在の保有を見る →</b></a>
				<a href="/blog/scorecard-45-stocks-2026q3/" class="evidence-card"><strong>📋 紹介銘柄の通信簿</strong><p>良かったものだけでなく、外れも含めて紹介後を答え合わせしています。</p><b>答え合わせを見る →</b></a>
			</div>
		</section>
		<section class="note-box">
			<h2><span>5</span> 分析を自分で再現したい方へ</h2>
			<p>noteで扱うのは、個別銘柄の推奨や目標株価ではありません。候補を絞る順番、確認する数字、除外条件、チェックリスト、Excelなど、<strong>別の銘柄にも使い回せる手順</strong>をまとめています。</p>
			<a href="/note/" class="primary note-link">有料noteの役割と商品を見る →</a>
		</section>
		<section class="last">
			<h2><span>6</span> 最新状況から入りたい方へ</h2>
			<div class="actions center"><a href="/blog/">最新記事を見る →</a><a href="/map">コンテンツマップを見る →</a><a href="/search">記事を検索する →</a></div>
		</section>
	</main>
	<Footer />
</body>
</html>
<style>
main{width:min(920px,calc(100% - 2em));margin:0 auto;padding:0 0 64px}.hero{text-align:center;padding:54px 0 26px}.eyebrow{display:inline-block;font-size:.72rem;font-weight:800;letter-spacing:.16em;color:#0F6E56;background:#E1F5EE;border:1px solid #9FE1CB;border-radius:999px;padding:5px 12px}h1{margin:14px 0 12px;font-size:clamp(2rem,7vw,3rem);color:var(--accent-dark)}.lead{max-width:720px;margin:0 auto;font-size:1rem;line-height:1.9;color:rgb(var(--gray-dark))}.promise{max-width:720px;margin:22px auto 0;padding:15px 18px;border:1px solid #B5D4F4;background:#F5FAFE;border-radius:12px;text-align:left;line-height:1.8;font-size:.9rem}.promise strong{color:#185FA5}section{margin-top:42px}h2{display:flex;align-items:center;gap:10px;font-size:clamp(1.15rem,4vw,1.45rem);color:var(--accent-dark);margin:0 0 14px}h2 span{display:inline-grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--accent-dark);color:white;font-size:.75rem}.panel,.note-box{border:1px solid #DDE3E8;background:white;border-radius:14px;padding:20px}.panel{display:flex;justify-content:space-between;gap:20px;align-items:center}.panel h3{margin:0 0 6px;font-size:1rem}.panel p,.note-box p{margin:0;line-height:1.8;color:rgb(var(--gray))}.actions{display:flex;gap:8px;flex-wrap:wrap}.actions a,.primary{display:inline-block;text-decoration:none;border:1px solid #B5D4F4;border-radius:9px;padding:10px 13px;font-weight:700;font-size:.85rem;color:#185FA5;background:#F5FAFE}.actions .primary,.primary{background:var(--accent-dark);color:white;border-color:var(--accent-dark)}.grid{display:grid;gap:12px}.paths{grid-template-columns:repeat(4,1fr)}.card{display:block;color:inherit;text-decoration:none;border:1px solid #DDE3E8;background:white;border-radius:12px;padding:16px}.card:hover,.evidence-card:hover,.read:hover{border-color:#9BB7CC;background:#FAFCFD}.icon{display:block;font-size:1.5rem;margin-bottom:6px}.card strong{display:block}.card p{margin:6px 0 8px;font-size:.8rem;line-height:1.7;color:rgb(var(--gray))}.card em{font-style:normal;font-size:.76rem;color:#185FA5;font-weight:700}.sub{color:rgb(var(--gray));font-size:.86rem;margin:-3px 0 12px}.reads{display:grid;gap:8px}.read{display:grid;grid-template-columns:38px 34px 1fr 20px;align-items:center;gap:8px;padding:13px 14px;border:1px solid #DDE3E8;background:white;border-radius:10px;color:inherit;text-decoration:none}.read>span{font-size:.7rem;color:#7A838C;font-weight:800}.read>b{font-size:1.25rem}.read div strong{display:block;font-size:.9rem}.read small{display:block;color:rgb(var(--gray));font-size:.76rem;line-height:1.6;margin-top:2px}.read em{font-style:normal;color:#185FA5;font-weight:800}.evidence{grid-template-columns:1fr 1fr}.evidence-card{display:block;text-decoration:none;color:inherit;border:1px solid #DDE3E8;border-radius:12px;padding:18px;background:white}.evidence-card>strong{color:var(--accent-dark)}.evidence-card p{color:rgb(var(--gray));font-size:.82rem;line-height:1.75}.evidence-card b{color:#185FA5;font-size:.8rem}.note-box{background:#FFFCF2;border-color:#E2C57A}.note-link{margin-top:14px}.last{text-align:center}.last h2{justify-content:center}.center{justify-content:center}
@media(max-width:760px){.paths{grid-template-columns:1fr 1fr}.evidence{grid-template-columns:1fr}.panel{display:block}.panel .actions{margin-top:14px}}@media(max-width:480px){.paths{grid-template-columns:1fr}.read{grid-template-columns:30px 28px 1fr 16px;padding:11px}.read small{display:none}}
</style>