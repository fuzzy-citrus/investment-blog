---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { columnAuthors } from '../../data/columnAuthors';

const posts = (await getCollection('blog'))
	.filter((p) => !p.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title="ブログ | バリュー商会" description="バリュー商会の投資記録" />
		<style>
			main {
				max-width: 860px;
				margin: 0 auto;
				padding: 2.5em 1em 4em;
			}
			h1 {
				font-size: 1.4em;
				color: var(--accent-dark);
				border-left: 4px solid var(--accent);
				padding-left: 0.6em;
				margin-bottom: 1.5em;
			}
			.post-list {
				display: flex;
				flex-direction: column;
				gap: 1em;
				list-style: none;
				padding: 0;
				margin: 0;
			}

			/* 通常記事カード */
			.post-card {
				border: 1.5px solid #e0e0e0;
				border-radius: 10px;
				overflow: hidden;
				background: white;
				box-shadow: 0 1px 4px rgba(0,0,0,5%);
				transition: box-shadow 0.2s;
			}
			.post-card:hover {
				box-shadow: 0 4px 12px rgba(0,0,0,10%);
			}
			.post-card.has-author {
				border-left: 5px solid var(--author-accent);
			}
			.author-badge {
				display: inline-flex;
				align-items: center;
				gap: 0.35em;
				align-self: flex-start;
				font-size: 0.72em;
				font-weight: 700;
				padding: 0.2em 0.7em;
				border-radius: 20px;
				margin-bottom: 0.5em;
				letter-spacing: 0.02em;
			}
			.author-emoji { font-size: 1.15em; }
			.post-card a {
				display: flex;
				align-items: stretch;
				text-decoration: none;
				color: inherit;
			}
			.post-card img {
				width: 220px;
				height: 140px;
				object-fit: cover;
				flex-shrink: 0;
			}
			.post-card-body {
				padding: 1em 1.2em;
				display: flex;
				flex-direction: column;
				justify-content: center;
				gap: 0.4em;
			}
			.post-card .post-title {
				font-size: 1em;
				font-weight: 700;
				color: rgb(var(--black));
				line-height: 1.4;
				margin: 0;
			}
			.post-card .post-desc {
				font-size: 0.82em;
				color: rgb(var(--gray));
				margin: 0;
				line-height: 1.5;
			}
			.post-card .post-date {
				font-size: 0.75em;
				color: rgb(var(--gray));
			}
			.post-card:hover .post-title {
				color: var(--accent-dark);
			}
			:global(.card-highlight) {
				color: #1a7a4a;
				font-weight: 700;
			}
			:global(.card-prereq) {
				font-size: 0.82em;
				color: rgb(var(--gray-dark));
				display: block;
				margin-top: 0.3em;
				line-height: 1.65;
			}
			:global(.card-note) {
				font-size: 0.82em;
				color: rgb(var(--gray));
				display: block;
				margin-top: 0.15em;
			}

			/* 銘柄分析カード */
			.stock-card {
				border-radius: 10px;
				overflow: hidden;
				box-shadow: 0 1px 4px rgba(0,0,0,8%);
				transition: box-shadow 0.2s;
			}
			.stock-card:hover {
				box-shadow: 0 4px 14px rgba(0,0,0,18%);
			}
			.stock-card.theme-event {
				border: 2.5px solid rgba(220,50,50,0.85);
				box-shadow: 0 0 0 3px rgba(220,50,50,0.12), 0 0 18px rgba(220,50,50,0.22), 0 2px 12px rgba(0,0,0,20%);
			}
			.stock-card.theme-event:hover {
				box-shadow: 0 0 0 3px rgba(220,50,50,0.22), 0 0 28px rgba(220,50,50,0.35), 0 4px 20px rgba(0,0,0,25%);
			}
			/* イベント案件注意バナー */
			.event-warning {
				display: flex;
				align-items: center;
				gap: 0.6em;
				background: rgba(220,50,50,0.07);
				border: 1px solid rgba(220,50,50,0.3);
				border-left: 3px solid rgba(220,50,50,0.8);
				border-radius: 6px;
				padding: 0.55em 0.9em;
				margin-bottom: 0.5em;
				font-size: 0.78em;
				color: #b03030;
				line-height: 1.5;
			}
			.event-warning-icon {
				font-size: 1em;
				flex-shrink: 0;
			}
			.event-warning strong {
				font-weight: 700;
			}
			.stock-card a {
				display: block;
				text-decoration: none;
				color: inherit;
				background: #1a2535;
			}
			.stock-card.theme-event a { background: #271400; }
			.stock-card.theme-event .stock-card-category {
				background: rgba(240,130,40,0.18);
				border: 1px solid rgba(240,130,40,0.5);
				color: #f09040;
			}
			.stock-card.theme-event .stock-card-target { color: #f09040; }
			.stock-card.theme-event .sc-kpi-value.green { color: #f09040; }
			.stock-card-header {
				padding: 1em 1.3em 0.8em;
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
				gap: 1em;
				flex-wrap: wrap;
			}
			.stock-card-left { flex: 1 1 0; min-width: 0; }
			.stock-card-badge {
				font-size: 0.6em;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: rgba(255,255,255,0.35);
				margin-bottom: 0.3em;
			}
			.stock-card-name {
				font-size: 1.15em;
				font-weight: 700;
				color: white;
				line-height: 1.2;
			}
			.stock-card-ticker {
				color: #e8803a;
				font-size: 0.85em;
			}
			.stock-card-category {
				display: inline-block;
				background: rgba(29,158,117,0.2);
				border: 1px solid rgba(29,158,117,0.35);
				color: #5dcca8;
				font-size: 0.65em;
				font-weight: 700;
				padding: 0.15em 0.6em;
				border-radius: 3px;
				margin-top: 0.35em;
				letter-spacing: 0.03em;
			}
			.stock-card-verdict {
				text-align: right;
				flex: 0 0 auto;
			}
			.stock-card-scenario-note {
				text-align: right;
				font-size: 0.58em;
				color: rgba(255,255,255,0.28);
				margin-top: -0.3em;
				margin-bottom: 0.6em;
				letter-spacing: 0.02em;
			}
			.stock-card-verdict-label {
				font-size: 0.6em;
				color: rgba(255,255,255,0.35);
				letter-spacing: 0.08em;
				text-transform: uppercase;
				margin-bottom: 0.2em;
			}
			.stock-card-target {
				font-size: 1.5em;
				font-weight: 700;
				color: #5dcca8;
				line-height: 1;
			}
			.stock-card-upside {
				font-size: 0.75em;
				color: rgba(255,255,255,0.45);
				margin-top: 0.15em;
			}
			.stock-card-desc {
				padding: 0 1.3em 0.8em;
				font-size: 0.78em;
				color: rgba(255,255,255,0.45);
				line-height: 1.5;
			}
			.stock-card-kpis {
				display: grid;
				grid-template-columns: repeat(5, 1fr);
				gap: 1px;
				background: rgba(255,255,255,0.06);
			}
			.sc-kpi {
				background: rgba(10,15,25,0.5);
				padding: 0.6em 0.8em;
			}
			.sc-kpi-label {
				font-size: 0.58em;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: rgba(255,255,255,0.28);
				margin-bottom: 0.25em;
			}
			.sc-kpi-value {
				font-size: 0.95em;
				font-weight: 700;
				font-variant-numeric: tabular-nums;
				color: white;
			}
			.sc-kpi-value.green { color: #5dcca8; }
			.sc-kpi-value.red   { color: #e06868; }
			.sc-kpi-value.amber { color: #e8803a; }
			.stock-card-note {
				font-size: 0.62em;
				color: rgba(255,255,255,0.35);
				padding: 0.3em 1.3em 0.5em;
				line-height: 1.4;
			}
			.stock-card-footer {
				padding: 0.55em 1.3em;
				background: rgba(0,0,0,0.2);
				font-size: 0.7em;
				color: rgba(255,255,255,0.3);
				display: flex;
				justify-content: space-between;
				align-items: center;
			}
			.stock-card:hover .stock-card-name {
				color: #a0e8d0;
			}

			/* フィルタータブ */
			.filter-bar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.5em;
				margin-bottom: 1.5em;
				flex-wrap: wrap;
			}
			.filter-tabs { display: flex; gap: 0.5em; flex-wrap: wrap; }
			.filter-note {
				font-size: 0.68em;
				color: #888;
				text-align: right;
				line-height: 1.5;
			}
			.filter-btn {
				padding: 0.4em 1.1em;
				border-radius: 20px;
				border: 1.5px solid #ccc;
				background: white;
				font-size: 0.85em;
				font-weight: 600;
				color: rgb(var(--gray-dark));
				cursor: pointer;
				transition: background 0.15s, border-color 0.15s, color 0.15s;
			}
			.filter-btn:hover {
				border-color: var(--accent);
				color: var(--accent-dark);
			}
			.filter-btn.active {
				background: var(--accent-dark);
				border-color: var(--accent-dark);
				color: white;
			}
			.post-list li[data-hidden] {
				display: none;
			}

			@media (max-width: 720px) {
				.post-card a { flex-direction: column; }
				.post-card img { width: 100%; height: 180px; }
				.stock-card-kpis { grid-template-columns: repeat(3, 1fr); }
				.stock-card-header { flex-direction: column; gap: 0.5em; }
				.stock-card-verdict { text-align: left; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>銘柄＆戦略の紹介</h1>
			<div class="filter-bar">
				<div class="filter-tabs">
					<button class="filter-btn" data-filter="stock">銘柄紹介</button>
					<button class="filter-btn" data-filter="column">投資コラム</button>
					<button class="filter-btn" data-filter="all">すべて</button>
				</div>
				<div class="filter-note">シナリオが大きく崩れない限り保有継続<br/>崩れた場合は売却を検討</div>
			</div>
			<ul class="post-list">
				{posts.map((post) => (
					<li data-type={post.data.stockCard ? 'stock' : 'column'}>
						{post.data.stockCard ? (
							/* 銘柄分析カード */
							<>
							{post.data.stockCard?.cardTheme === 'event' && (
								<div class="event-warning">
									<span class="event-warning-icon">⚠️</span>
									<span><strong>要警戒・期限あり案件</strong> — イベント（TOB・売却）の決着次第でシナリオが大きく変わります。売却中止・長期化の場合は即撤退を検討してください。</span>
								</div>
							)}
							<div class={`stock-card${post.data.stockCard?.cardTheme === 'event' ? ' theme-event' : ''}`}>
								<a href={`/blog/${post.id}/`}>
									<div class="stock-card-header">
										<div class="stock-card-left">
											<div class="stock-card-badge">銘柄分析 — {post.data.stockCard.category}</div>
											<div class="stock-card-name">
												{post.data.stockCard.companyName}
												<span class="stock-card-ticker">（{post.data.stockCard.ticker}）</span>
											</div>
											<div class="stock-card-category">{post.data.stockCard.category}</div>
										</div>
										<div class="stock-card-verdict">
											<div class="stock-card-verdict-label">{post.data.stockCard?.cardTheme === 'event' ? 'TOB・売却決着時の 期待価格' : '3年保有想定の 期待価格'}</div>
											<div class="stock-card-target">{post.data.stockCard.targetPrice.toLocaleString()}円</div>
											<div class="stock-card-upside">現在比 {post.data.stockCard.upside}</div>
										</div>
									</div>
									<div class="stock-card-desc">{post.data.description}</div>
									<div class="stock-card-kpis">
										<div class="sc-kpi">
											<div class="sc-kpi-label">現在株価</div>
											<div class="sc-kpi-value amber">{post.data.stockCard.currentPrice.toLocaleString()}円</div>
										</div>
										<div class="sc-kpi">
											<div class="sc-kpi-label">3年期待価格</div>
											<div class="sc-kpi-value green">{post.data.stockCard.targetPrice.toLocaleString()}円</div>
										</div>
										<div class="sc-kpi">
											<div class="sc-kpi-label">期待リターン</div>
											<div class="sc-kpi-value green">{post.data.stockCard.upside}</div>
										</div>
										<div class="sc-kpi">
											<div class="sc-kpi-label">最大下落</div>
											<div class="sc-kpi-value red">{post.data.stockCard.downside}</div>
										</div>
										<div class="sc-kpi">
											<div class="sc-kpi-label">修正PBR</div>
											<div class="sc-kpi-value red">{post.data.stockCard.modifiedPBR}</div>
										</div>
									</div>

									<div class="stock-card-footer">
										<FormattedDate date={post.data.pubDate} />
										<span>→ 分析を読む</span>
									</div>
								</a>
							</div>
							</>
						) : (
							/* 通常記事カード */
							<div class={`post-card${columnAuthors[post.id] ? ' has-author' : ''}`} style={columnAuthors[post.id] ? `--author-accent:${columnAuthors[post.id].accent}` : ''}>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={220} height={140} src={post.data.heroImage} alt="" />
									)}
									<div class="post-card-body">
										{columnAuthors[post.id] && (
											<span class="author-badge" style={`background:${columnAuthors[post.id].fill};color:${columnAuthors[post.id].text}`}>
												<span class="author-emoji">{columnAuthors[post.id].emoji}</span>
												{columnAuthors[post.id].name}の発信
											</span>
										)}
										<h4 class="post-title">{post.data.title}</h4>
										{post.data.cardDesc
											? <p class="post-desc" set:html={post.data.cardDesc} />
											: <p class="post-desc">{post.data.description}</p>
										}
										<p class="post-date"><FormattedDate date={post.data.pubDate} /></p>
									</div>
								</a>
							</div>
						)}
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
	<script>
		const btns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
		const items = document.querySelectorAll<HTMLLIElement>('.post-list li');

		function applyFilter(f: string) {
			btns.forEach(b => b.classList.toggle('active', b.dataset.filter === f));
			items.forEach(li => {
				if (f === 'all' || li.dataset.type === f) {
					li.removeAttribute('data-hidden');
				} else {
					li.setAttribute('data-hidden', '');
				}
			});
		}

		// URLパラメータで初期フィルター
		const params = new URLSearchParams(location.search);
		const init = params.get('type');
		applyFilter(init === 'stock' || init === 'column' ? init : 'stock');

		btns.forEach(btn => {
			btn.addEventListener('click', () => applyFilter(btn.dataset.filter!));
		});
	</script>
</html>
