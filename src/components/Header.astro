---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import AssetSidebar from './AssetSidebar.astro';
import BookSidebar from './BookSidebar.astro';
---

<header>
	<nav>
		<h2><a href="/">🏢 {SITE_TITLE}</a></h2>
		<button class="hamburger" aria-label="メニュー" aria-expanded="false">
			<span></span><span></span><span></span>
		</button>
		<div class="internal-links">
			<HeaderLink href="/">ホーム</HeaderLink>
			<div class="dropdown-wrap">
				<span class="dropdown-label">コンテンツ <span class="arrow">▾</span></span>
				<div class="dropdown-menu" role="menu">
					<a href="/blog/?type=stock" role="menuitem">銘柄紹介</a>
					<a href="/blog/?type=column" role="menuitem">投資コラム</a>
					<a href="/map" role="menuitem">コンテンツマップ</a>
				</div>
			</div>
			<div class="dropdown-wrap">
				<span class="dropdown-label">各種紹介 <span class="arrow">▾</span></span>
				<div class="dropdown-menu" role="menu">
					<a href="/company" role="menuitem">会社紹介</a>
					<a href="/about" role="menuitem">筆者紹介</a>
					<a href="/org" role="menuitem">会社組織図・勢力図</a>
					<a href="/characters" role="menuitem">部下の紹介</a>
				</div>
			</div>
			<HeaderLink href="/search">🔍</HeaderLink>
			<a href="https://x.com/numasoko_value" target="_blank" rel="noopener" class="x-link" aria-label="X（旧Twitter）をフォロー">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
			</a>
		</div>
	</nav>
</header>
<AssetSidebar />
<BookSidebar />
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--accent-dark);
		box-shadow: 0 2px 8px rgba(0,0,0,20%);
		position: relative;
		z-index: 100;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
		color: white;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.internal-links {
		display: flex;
		align-items: center;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgba(255,255,255,0.85);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
		color: white;
	}
	nav a:hover {
		color: white;
	}
	.x-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: rgba(255,255,255,0.85);
		padding: 0.5em;
		border-bottom: 4px solid transparent;
	}
	.x-link:hover { color: white; }

	/* コンテンツ プルダウン */
	.dropdown-wrap {
		position: relative;
		display: flex;
		align-items: center;
	}
	.dropdown-label {
		padding: 1em 0.5em;
		color: rgba(255,255,255,0.85);
		font-size: 1em;
		font-weight: inherit;
		cursor: pointer;
		border: none;
		border-bottom: 4px solid transparent;
		background: transparent;
		user-select: none;
		white-space: nowrap;
		line-height: inherit;
		font-family: inherit;
	}
	.dropdown-label:hover,
	.dropdown-wrap:hover .dropdown-label {
		color: white;
	}
	.dropdown-label .arrow {
		font-size: 0.7em;
		display: inline-block;
		transition: transform 0.2s;
	}
	.dropdown-wrap:hover .arrow {
		transform: rotate(180deg);
	}
	.dropdown-menu {
		display: none;
		position: absolute;
		top: calc(100% + 0px);
		left: 0;
		background: #1e3a2f;
		border: 1px solid rgba(255,255,255,0.15);
		border-top: none;
		border-radius: 0 0 6px 6px;
		box-shadow: 0 6px 16px rgba(0,0,0,35%);
		min-width: 140px;
		z-index: 200;
		overflow: hidden;
	}
	.dropdown-wrap:hover .dropdown-menu {
		display: block;
	}
	.dropdown-menu a {
		display: block;
		padding: 0.6em 0.9em;
		color: rgba(255,255,255,0.85);
		text-decoration: none;
		border-bottom: 1px solid rgba(255,255,255,0.08);
		font-size: 0.78em;
		white-space: nowrap;
	}
	.dropdown-menu a:last-child {
		border-bottom: none;
	}
	.dropdown-menu a:hover {
		background: rgba(255,255,255,0.12);
		color: white;
	}

	/* ハンバーガーボタン（デスクトップでは非表示） */
	.hamburger {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5em;
	}
	.hamburger span {
		display: block;
		width: 22px;
		height: 2px;
		background: rgba(255,255,255,0.85);
		border-radius: 2px;
		transition: transform 0.2s, opacity 0.2s;
	}
	.hamburger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
	.hamburger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
	.hamburger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

	@media (max-width: 720px) {
		h2 { font-size: 0.9em; }
		.hamburger { display: flex; }
		.internal-links {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			background: var(--accent-dark);
			border-top: 1px solid rgba(255,255,255,0.1);
			z-index: 999;
			padding: 0.5em 0;
		}
		.internal-links.open { display: flex; }
		nav a { padding: 0.75em 1.2em; font-size: 0.95em; border-bottom: none; }
		.dropdown-label { padding: 0.75em 1.2em; font-size: 0.95em; }
		.dropdown-menu {
			position: static;
			display: none;
			box-shadow: none;
			border-radius: 0;
			border: none;
			border-top: 1px solid rgba(255,255,255,0.06);
			background: rgba(0,0,0,0.2);
		}
		.dropdown-wrap.open .dropdown-menu { display: block; }
		.dropdown-menu a { padding: 0.65em 2em; font-size: 0.9em; }
	}

	/* タッチデバイス：open クラスで表示（デスクトップも対応） */
	@media (min-width: 721px) {
		.dropdown-wrap.open .dropdown-menu { display: block; }
		.dropdown-wrap.open .arrow { transform: rotate(180deg); }
	}
</style>

<script>
  // ハンバーガー開閉
  const hamburger = document.querySelector('.hamburger');
  const links = document.querySelector('.internal-links');
  hamburger?.addEventListener('click', () => {
    const open = links.classList.toggle('open');
    hamburger.setAttribute('aria-expanded', String(open));
  });

  // ドロップダウン（クリック対応）
  document.querySelectorAll('.dropdown-label').forEach(label => {
    label.addEventListener('click', e => {
      const wrap = label.closest('.dropdown-wrap');
      const isOpen = wrap.classList.contains('open');
      document.querySelectorAll('.dropdown-wrap').forEach(w => w.classList.remove('open'));
      if (!isOpen) wrap.classList.add('open');
    });
  });
  document.addEventListener('click', e => {
    if (!e.target.closest('.dropdown-wrap') && !e.target.closest('.hamburger')) {
      document.querySelectorAll('.dropdown-wrap').forEach(w => w.classList.remove('open'));
    }
  });
</script>

