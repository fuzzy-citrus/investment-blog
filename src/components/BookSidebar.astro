    msg: '【集中連載】守田「投資家の意思決定論」全4話＋花岡「配当シリーズ」全4話を6/13〜16で公開。NISA vs 信用の期待リターン比較も。資金管理と出口の土台はこの一群。',
    sig: '守田',
  },
  {
    date: '2026.06.11',
    msg: '【広済堂HD(7868)｜A+→A++に格上げ】下げたことで、NAVとの差がさらに開いた。',
    sig: '待伏',
  },
  {
    date: '2026.06.09',
    msg: '【NSSOL(2327)】アクティビスト3D の動向を注視中。6/19総会後の防衛策消滅で買い増し解禁へ。変更報告書に即反応できる体制を維持。',
    sig: '待伏',
  },
  {
    date: '2026.05.29',
    msg: 'TOB件数が加速中。日本の割安ニッチトップが今熱い！',
    sig: '沼田',
  },
];

// 掲示板は記事の公開とポートフォリオの更新だけを載せる（2026-09-19 ユーザー指示）。
// サイト改修のお知らせ（siteUpdates）は、トップの最終更新日時にだけ使う。
const bulletins = manualBulletins;
---

<!-- 社内情報サイドバー（右側・1100px以上表示） -->
<div class="info-sb">

  <!-- 社内掲示板 -->
  <div class="info-sb-section">
    <p class="info-sb-head">📌 社内掲示板</p>
    <div class="info-sb-bulletins-scroll">
      {bulletins.map(b => (
        <div class="info-sb-bulletin">
          <div class="info-sb-bulletin-date">{b.date}</div>
          <div class="info-sb-bulletin-msg">{b.msg}</div>
          <div class="info-sb-bulletin-sig">— {b.sig}</div>
        </div>
      ))}
    </div>
  </div>

  <div class="info-sb-divider"></div>

  <!-- 筆者紹介 -->
  <div class="info-sb-section">
    <p class="info-sb-head">🧑‍💼 筆者</p>
    <div class="info-sb-author">
      <div class="info-sb-author-top">
        <div class="info-sb-author-name">沼田課長</div>
        <div class="info-sb-avatar" role="img" aria-label="沼田課長"></div>
      </div>
      <div class="info-sb-author-title">課長・プレイングマネージャー</div>
      <div class="info-sb-author-bio">野村信用を活用したバリュー株×TOB待ち伏せ戦略。TOBヒット20件超。<span class="info-sb-goal">【目標】4,308万円 → 2億円（2030年）</span></div>
    </div>
  </div>

  <div class="info-sb-divider"></div>

  <!-- フォロー -->
  <div class="info-sb-section">
    <p class="info-sb-head">𝕏 フォロー</p>
    <a href="https://x.com/numasoko_value" target="_blank" rel="noopener" class="info-sb-x-link">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      <span>@numasoko_value</span>
    </a>
    <p class="info-sb-mail-note">速報・銘柄つぶやきはこちら</p>
  </div>

  <div class="info-sb-divider"></div>

  <!-- お問い合わせ -->
  <div class="info-sb-section">
    <p class="info-sb-head">✉️ お問い合わせ</p>
    <a href="https://x.com/numasoko_value" target="_blank" rel="noopener" class="info-sb-mail-link">
      公式X @numasoko_value
    </a>
    <p class="info-sb-mail-note">ブログに関するご連絡はこちらへ</p>
  </div>

  <div class="info-sb-divider"></div>

  <!-- 記事アップ状況 -->
  <div class="info-sb-section">
    <p class="info-sb-head">📝 更新状況</p>
    <ul class="info-sb-posts">
      {posts.map(p => (
        <li class="info-sb-post-item">
          <a href={`/blog/${p.id}/`} class="info-sb-post-link">
            <span class="info-sb-post-date">
              {p.data.pubDate.toLocaleDateString('ja-JP', { month: 'numeric', day: 'numeric' })}
            </span>
            <span class="info-sb-post-title">{p.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="info-sb-divider"></div>

  <!-- TOBヒット実績 -->
  <div class="info-sb-section">
    <p class="info-sb-head">🎯 TOBヒット実績</p>
    <div class="info-sb-tob">
      <div class="info-sb-tob-count">20<span class="info-sb-tob-unit">件</span></div>
      <div class="info-sb-tob-label">上場廃止ヒット</div>
      <div class="info-sb-tob-sub">上場維持含む合計 30件超</div>
      <a href="/blog/value-tob-strategy-2026/" class="info-sb-tob-link">詳細を見る →</a>
    </div>
  </div>

</div>

<style is:global>
  .info-sb {
    position: fixed;
    top: 0;
    right: 0;
    width: calc((100vw - 760px) / 2);
    max-width: 160px;
    height: 100vh;
    overflow-y: auto;
    scrollbar-width: none;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: safe center;
    gap: 0;
    z-index: 9;
    background: linear-gradient(170deg, #252525 0%, #1a1a1a 100%);
    border-left: 1px solid rgba(232,184,75,0.2);
    padding: 86px 0 1em;
    color: #fff;
  }
  .info-sb::-webkit-scrollbar { display: none; }
  @media (min-width: 1100px) {
    .info-sb { display: flex; }
  }
  .info-sb-section {
    width: 100%;
    padding: 0.55em 0.6em;
    display: flex;
    flex-direction: column;
    gap: 0.3em;
  }
  .info-sb-head {
    font-size: 0.58em;
    font-weight: 800;
    color: #f5d47a;
    margin: 0 0 0.3em;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }
  .info-sb-divider {
    width: 88%;
    height: 1px;
    background: rgba(232,184,75,0.2);
    flex-shrink: 0;
  }
  /* 掲示板 */
  .info-sb-bulletins-scroll {
    display: flex;
    flex-direction: column;
    gap: 0.4em;
    max-height: 120px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(232,184,75,0.3) transparent;
  }
  .info-sb-bulletins-scroll::-webkit-scrollbar { width: 3px; }
  .info-sb-bulletins-scroll::-webkit-scrollbar-thumb { background: rgba(232,184,75,0.3); border-radius: 2px; }
  .info-sb-bulletin {
    background: rgba(255,255,255,0.06);
    border-left: 2px solid rgba(232,184,75,0.5);
    border-radius: 0 4px 4px 0;
    padding: 0.35em 0.45em;
    display: flex;
    flex-direction: column;
    gap: 0.2em;
  }
  .info-sb-bulletin-date {
    font-size: 0.5em;
    color: rgba(232,184,75,0.6);
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .info-sb-bulletin-msg {
    font-size: 0.52em;
    color: rgba(255,255,255,0.82);
    line-height: 1.6;
  }
  .info-sb-bulletin-sig {
    font-size: 0.5em;
    color: rgba(232,184,75,0.6);
    text-align: right;
    font-weight: 700;
  }
  /* 筆者 */
  .info-sb-author {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
  }
  .info-sb-author-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .info-sb-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    flex-shrink: 0;
    border: 1px solid rgba(232,184,75,0.4);
    background: url('/images/brand/numata-author-20260914.jpg') center / cover no-repeat;
    margin-top: -8px;
    margin-right: 12px;
  }
  .info-sb-author-name {
    font-size: 0.6em;
    font-weight: 800;
    color: #fff;
    letter-spacing: 0.04em;
  }
  .info-sb-author-title {
    font-size: 0.48em;
    color: rgba(232,184,75,0.7);
    font-weight: 600;
  }
  .info-sb-author-bio {
    font-size: 0.5em;
    color: rgba(255,255,255,0.68);
    line-height: 1.65;
    margin-top: 0.2em;
  }
  /* 更新状況 */
  .info-sb-posts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1em;
    max-height: 140px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(232,184,75,0.3) transparent;
  }
  .info-sb-posts::-webkit-scrollbar { width: 3px; }
  .info-sb-posts::-webkit-scrollbar-thumb { background: rgba(232,184,75,0.3); border-radius: 2px; }
  .info-sb-post-item {
    width: 100%;
  }
  .info-sb-post-link {
    display: flex;
    flex-direction: column;
    gap: 0.05em;
    text-decoration: none;
    padding: 0.3em 0.3em;
    border-radius: 4px;
    transition: background 0.12s;
  }
  .info-sb-post-link:hover {
    background: rgba(255,255,255,0.08);
  }
  .info-sb-post-date {
    font-size: 0.46em;
    color: rgba(232,184,75,0.6);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .info-sb-post-title {
    font-size: 0.5em;
    color: rgba(255,255,255,0.75);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* TOBヒット実績 */
  .info-sb-tob {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15em;
    background: rgba(232,184,75,0.08);
    border: 1px solid rgba(232,184,75,0.3);
    border-radius: 6px;
    padding: 0.5em 0.4em 0.55em;
    text-align: center;
  }
  .info-sb-tob-count {
    font-size: 1.6em;
    font-weight: 800;
    color: #e8b84b;
    line-height: 1;
  }
  .info-sb-tob-unit {
    font-size: 0.5em;
    font-weight: 700;
    color: rgba(232,184,75,0.7);
    margin-left: 0.1em;
  }
  .info-sb-tob-label {
    font-size: 0.52em;
    font-weight: 700;
    color: rgba(255,255,255,0.8);
    letter-spacing: 0.03em;
  }
  .info-sb-tob-sub {
    font-size: 0.46em;
    color: rgba(255,255,255,0.4);
    line-height: 1.5;
  }
  .info-sb-tob-link {
    font-size: 0.48em;
    color: rgba(232,184,75,0.7);
    text-decoration: none;
    font-weight: 600;
    margin-top: 0.2em;
  }
  .info-sb-tob-link:hover { color: #e8b84b; }
  .info-sb-mail-link {
    display: block;
    font-size: 0.48em;
    color: rgba(232,184,75,0.85);
    text-decoration: none;
    font-weight: 600;
    word-break: break-all;
    line-height: 1.5;
    text-align: center;
    background: rgba(232,184,75,0.08);
    border: 1px solid rgba(232,184,75,0.25);
    border-radius: 5px;
    padding: 0.4em 0.5em;
    margin-top: 0.3em;
  }
  .info-sb-mail-link:hover { background: rgba(232,184,75,0.15); color: #e8b84b; }
  .info-sb-x-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35em;
    font-size: 0.5em;
    font-weight: 700;
    color: rgba(255,255,255,0.9);
    text-decoration: none;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 5px;
    padding: 0.45em 0.5em;
    margin-top: 0.3em;
    word-break: break-all;
  }
  .info-sb-x-link:hover { background: rgba(255,255,255,0.16); color: #fff; }
  .info-sb-mail-note {
    font-size: 0.44em;
    color: rgba(255,255,255,0.3);
    text-align: center;
    margin: 0.3em 0 0;
    line-height: 1.4;
  }
  .info-sb-goal {
    display: block;
    margin-top: 0.3em;
    color: rgba(232,184,75,0.8);
    font-weight: 700;
  }
</style>
