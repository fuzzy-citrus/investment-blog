---
import type { CollectionEntry } from 'astro:content';
import { stockRanks } from '../data/stockRanks';
import { rankChanges } from '../data/rankChanges';
interface Props { posts: CollectionEntry<'blog'>[]; currentRank?: string }
const { posts, currentRank } = Astro.props;
const stocks = posts.filter(p => !p.data.draft && p.data.stockCard?.rating);

// 直近のランク変更を新しい順に並べ、先頭2〜3件だけ表示する
const recentChanges = [...rankChanges]
  .sort((a, b) => b.changedAt.localeCompare(a.changedAt))
  .slice(0, 3);
const formatChangeDate = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  return `${y}/${m}/${d}`;
};
---
<section class="stock-ranks" aria-labelledby="stock-ranks-title">
  <div class="section-header"><h2 id="stock-ranks-title">📋 紹介銘柄</h2><a href="/blog/">すべて見る →</a></div>
  <p class="guide">全{stocks.length}銘柄｜ランク別の一覧へ</p>
  <div class="rank-layout">
    <nav class="rank-grid" aria-label="銘柄ランク">
      {stockRanks.map(({ rating, slug }) => (
        <a href={`/stocks/${slug}/`} aria-current={currentRank === rating ? 'page' : undefined}
          class:list={['rank-button', rating === 'A++' ? 'rank-top' : rating === 'A+' ? 'rank-gold' : rating.startsWith('B') ? 'rank-b' : 'rank-green']}>
          <span class="rating">{rating}</span><span class="count">{stocks.filter(p => p.data.stockCard!.rating === rating).length}銘柄</span>
        </a>
      ))}
    </nav>
    {recentChanges.length > 0 && (
      <aside class="rank-changes" aria-labelledby="rank-changes-title">
        <p id="rank-changes-title" class="rc-title">🔄 変更 {formatChangeDate(recentChanges[0].changedAt)}</p>
        <ul class="rc-list">
          {recentChanges.map(change => (
            <li>
              <a class="rc-row" href={`/blog/${change.articleSlug}/`}
                aria-label={`${change.companyName}（${change.ticker}）のランクを${change.from}から${change.to}に変更。詳細記事へ`}>
                <span class="rc-date">{formatChangeDate(change.changedAt)}</span>
                <span class="rc-name">{change.companyName}<span class="rc-ticker">（{change.ticker}）</span></span>
                <span class="rc-diff" aria-hidden="true"><span class="rc-from">{change.from}</span><span class="rc-arrow">→</span><span class="rc-to">{change.to}</span></span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</section>
<style>
  .stock-ranks { min-width: 0; border: 1px solid #d9e3dc; border-radius: 12px; background: #fff; overflow: hidden; container-type: inline-size; }
  .section-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 16px; background: #f0f4f0; border-bottom: 1px solid #d9e3dc; }
  h2 { margin: 0; font-size: 18px; color: #244f3c; }
  .section-header a { font-size: 14px; font-weight: 600; color: #285d46; text-decoration: none; white-space: nowrap; }
  .guide { margin: 9px 12px 7px; color: #66736b; font-size: 11px; line-height: 1.5; }
  .rank-layout { padding: 0 10px 10px; }
  .rank-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 7px; align-items: start; }
  .rank-button { font: inherit; display: flex; align-items: center; gap: 6px; box-sizing: border-box; height: 48px; text-decoration: none; padding: 7px 9px; border: 1px solid; border-radius: 8px; cursor: pointer; text-align: left; box-shadow: 0 2px 6px rgba(30,48,36,.08); }
  .rank-top { background: linear-gradient(145deg,#f9d966 0%,#d99a20 48%,#b97910 100%); border-color: #d68b18; color: #5c3a00; box-shadow: inset 0 1px 1px #fff1ab, inset 0 -2px 1px #9b650d, 0 3px 0 #926111, 0 5px 9px rgba(128,83,10,.25); }
  .rank-gold { background: linear-gradient(135deg,#fff8dc 0%,#ffe69b 100%); border-color: #e3bd4a; color: #6a5000; }
  .rank-green { background: linear-gradient(135deg,#f2faf3 0%,#dcefe0 100%); border-color: #a8cbb1; color: #285a3e; }
  .rank-b { background: linear-gradient(135deg,#f2f6fb 0%,#dde8f3 100%); border-color: #b4c7da; color: #38516b; }
  .rating { font-size: 17px; font-weight: 900; letter-spacing: -.03em; }
  .count { font-size: 11px; font-weight: 700; white-space: nowrap; opacity: .82; }
  .rank-button:hover { filter: brightness(1.05); }
  a:focus-visible { outline: 3px solid #247d60; outline-offset: -3px; }
  [aria-current='page'] { outline: 2px solid currentColor; outline-offset: -4px; }
  @container (max-width: 340px) {
    .rank-button { padding: 6px; gap: 4px; }
    .rating { font-size: 15px; }
    .count { font-size: 10px; }
  }

  /* ── 直近のランク変更（控えめな更新記録） ── */
  .rank-changes { margin-top: 10px; }
  .rc-title { margin: 0 0 6px; font-size: 11px; font-weight: 700; color: #66736b; }
  .rc-list { list-style: none; margin: 0; padding: 0; border: 1px solid #e3e9e4; border-radius: 8px; overflow: hidden; background: #fafcfa; }
  .rc-list li + li { border-top: 1px solid #e9eee9; }
  .rc-row { display: flex; align-items: center; gap: 8px; padding: 7px 9px; text-decoration: none; color: #3a463f; }
  .rc-row:hover, .rc-row:focus-visible { background: #f0f4f0; }
  .rc-date { flex: 0 0 auto; font-size: 10px; color: #8a948d; font-variant-numeric: tabular-nums; }
  .rc-name { flex: 1 1 auto; min-width: 0; font-size: 12px; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rc-ticker { margin-left: 3px; font-size: 10px; font-weight: 400; color: #7c877f; }
  .rc-diff { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 3px; font-size: 11px; font-weight: 700; white-space: nowrap; }
  .rc-from { color: #8a948d; }
  .rc-arrow { color: #b3bab4; font-weight: 400; }
  .rc-to { color: #285d46; }

  /* PC幅：ランクボタン群（3列グリッド）の末尾行に生じる空白へ変更履歴パネルを差し込む */
  @container (min-width: 420px) {
    .rank-layout { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 7px; }
    .rank-grid { display: contents; }
    .rank-changes { grid-column: 2 / 4; grid-row: 3; margin-top: 0; align-self: stretch; display: flex; align-items: center; gap: 7px; padding: 5px 7px; border: 1px solid #e3e9e4; border-radius: 8px; background: #fafcfa; box-sizing: border-box; min-height: 48px; }
    .rc-title { flex: 0 0 auto; margin: 0; font-size: 10px; }
    .rc-list { flex: 1 1 auto; min-width: 0; border: 0; border-radius: 0; background: transparent; }
    .rc-list li + li { border-top: 0; }
    .rc-row { padding: 1px 0; gap: 5px; line-height: 1.25; }
    .rc-date { display: none; }
    .rc-name { font-size: 10px; }
    .rc-ticker { font-size: 9px; }
    .rc-diff { font-size: 10px; }
  }
</style>



