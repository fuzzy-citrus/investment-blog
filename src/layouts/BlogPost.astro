---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Comments from '../components/Comments.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, stockCard, noteUrl, related } = Astro.props;

const analysisFileMap: Record<string, string> = {
	'9036': 'tobu-network-9036',
	'7485': 'okaya-kouki-7485',
	'9045': 'keihan-hd-9045',
	'7868': 'kozosodo-hd-7868',
	'2327': 'nssol-2327',
	'1450': 'tanaken-1450',
	'5900': 'daiken-5900',
	'1716': 'daiichi-cutter-1716',
	'4820': 'em-systems-4820',
	'9755': 'oyo-9755',
};
const analysisExists = new Set(['9036','8071','4685','9414','3004','368A','6165','7061','7485','9045','7868','2327','1450','5900','1716','4820','9755']);
// 完全版分析ファイルは noteUrl（…/analysis/<slug>.html）から自動導出。
// 新規銘柄は noteUrl を書くだけでヒーローの「📊 完全版分析資料」リンクが出る（上のマップは旧記事のフォールバック）
const analysisFromNote = noteUrl?.match(/\/analysis\/([^/]+)\.html$/)?.[1] ?? null;
const analysisFile = analysisFromNote
	?? (stockCard && analysisExists.has(stockCard.ticker)
		? (analysisFileMap[stockCard.ticker] ?? stockCard.ticker)
		: null);

// 株価の基準日＝記事公開日。古い記事の currentPrice を「今の株価」と誤読させないための表示
const priceAsOf = pubDate.toLocaleDateString('ja-JP', {
	timeZone: 'Asia/Tokyo',
	year: 'numeric',
	month: 'numeric',
	day: 'numeric',
});

const blogAll = (await getCollection('blog')).filter((p) => !p.data.draft);
// related frontmatter（スラッグ配列）で指定された記事を優先。未指定は最新3件にフォールバック
const relatedPicked = (related ?? [])
	.map(slug => blogAll.find(p => p.id === slug))
	.filter((p): p is NonNullable<typeof p> => Boolean(p) && p!.data.title !== title);
const allPosts = relatedPicked.length > 0
	? relatedPicked.slice(0, 4)
	: blogAll
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
		.filter(p => p.data.title !== title)
		.slice(0, 3);

const articleJsonLd = {
	"@context": "https://schema.org",
	"@type": "Article",
	"headline": title,
	"description": description,
	"datePublished": pubDate.toISOString(),
	"dateModified": (updatedDate ?? pubDate).toISOString(),
	"author": { "@type": "Person", "name": "沼底バリュー商会" },
	"publisher": {
		"@type": "Organization",
		"name": "沼底バリュー商会",
		"url": Astro.site?.toString() ?? ""
	},
	"inLanguage": "ja",
	"url": Astro.url.toString(),
};
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} ogType="article" />
		<script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			/* ストックカードヒーロー */
			.stock-hero {
				background: #1a2535;
				padding: 2em 0;
			}
			.stock-hero.theme-event {
				background: #271400 !important;
			}
			.stock-hero.theme-event .stock-category {
				background: rgba(240,130,40,0.18) !important;
				border: 1px solid rgba(240,130,40,0.5) !important;
				color: #f09040 !important;
			}
			.stock-hero.theme-event .stock-verdict {
				background: rgba(240,130,40,0.12) !important;
				border: 1px solid rgba(240,130,40,0.4) !important;
			}
			.stock-hero.theme-event .verdict-price {
				color: #f09040 !important;
			}
			.stock-hero.theme-event .kpi-value.green { color: #f09040 !important; }
			.stock-hero.theme-event .stock-analysis-link { background: rgba(0,0,0,0.35); }
			.stock-hero.theme-event .stock-analysis-link a { color: #f09040 !important; }
			.stock-hero.theme-event .stock-analysis-link a:hover { color: #ffc880 !important; }
			.stock-hero-inner {
				max-width: 720px;
				margin: 0 auto;
				padding: 0 1.5em;
			}
			.stock-hero-top {
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
				gap: 1.5em;
				flex-wrap: wrap;
				margin-bottom: 1.2em;
			}
			.stock-hero-top > div:first-child { flex: 1 1 0; min-width: 0; }
			.stock-verdict { flex-shrink: 0; }
			.stock-badge {
				font-size: 0.65em;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: rgba(255,255,255,0.4);
				margin-bottom: 0.4em;
			}
			.stock-name {
				font-size: 1.6em;
				font-weight: 700;
				color: white;
				line-height: 1.2;
			}
			.stock-ticker {
				font-size: 0.9em;
				color: #e8803a;
				font-weight: 600;
			}
			.stock-category {
				display: inline-block;
				background: rgba(29,158,117,0.2);
				border: 1px solid rgba(29,158,117,0.4);
				color: #5dcca8;
				font-size: 0.7em;
				font-weight: 700;
				padding: 0.2em 0.7em;
				border-radius: 3px;
				margin-top: 0.4em;
			}
			.stock-verdict {
				background: rgba(29,158,117,0.12);
				border: 1px solid rgba(29,158,117,0.3);
				border-radius: 8px;
				padding: 0.8em 1.2em;
				text-align: center;
				min-width: 160px;
			}
			.verdict-label {
				font-size: 0.65em;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: rgba(255,255,255,0.35);
				margin-bottom: 0.3em;
			}
			.verdict-price {
				font-size: 1.8em;
				font-weight: 700;
				color: #5dcca8;
				line-height: 1;
			}
			.verdict-upside {
				font-size: 0.8em;
				color: rgba(255,255,255,0.5);
				margin-top: 0.2em;
			}
			.stock-scenario-note {
				text-align: right;
				font-size: 0.6em;
				color: rgba(255,255,255,0.28);
				margin-bottom: 0.7em;
				margin-top: -0.3em;
				letter-spacing: 0.02em;
			}
			.stock-kpis {
				display: grid;
				grid-template-columns: repeat(5, 1fr);
				gap: 1px;
				background: rgba(255,255,255,0.07);
				border-radius: 6px;
				overflow: hidden;
			}
			.kpi {
				background: rgba(10,15,25,0.4);
				padding: 0.7em 0.8em;
			}
			.kpi-label {
				font-size: 0.6em;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: rgba(255,255,255,0.3);
				margin-bottom: 0.3em;
			}
			.kpi-value {
				font-size: 1.05em;
				font-weight: 700;
				color: white;
				font-variant-numeric: tabular-nums;
			}
			.kpi-value.green { color: #5dcca8; }
			.kpi-value.red   { color: #e06868; }
			.kpi-value.amber { color: #e8803a; }
			.kpi-value.blue  { color: #7ab0e8; }
			.kpi-asof {
				font-size: 0.58em;
				color: rgba(255,255,255,0.35);
				margin-top: 0.3em;
				font-variant-numeric: tabular-nums;
			}
			/* prose */
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				font-size: 1.9em;
				line-height: 1.45;
				word-break: keep-all;
				overflow-wrap: break-word;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on { font-style: italic; }
			.stock-analysis-link {
				padding: 0.6em 1.5em;
				background: rgba(0,0,0,0.25);
				border-top: 1px solid rgba(255,255,255,0.06);
			}
			.stock-analysis-link a {
				font-size: 0.78em;
				color: #5dcca8;
				text-decoration: none;
				font-weight: 600;
				letter-spacing: 0.02em;
			}
			.stock-analysis-link a:hover {
				color: #a0e8d0;
				text-decoration: underline;
			}
			@media (max-width: 720px) {
				.stock-kpis { grid-template-columns: repeat(3, 1fr); }
				.stock-name { font-size: 1.3em; }
				.verdict-price { font-size: 1.4em; }
					.prose { padding: 1em 0.6em; }
					.title { padding: 0.5em 0; }
					.title h1 { font-size: 1.5em; line-height: 1.4; }
					.stock-hero-inner { padding: 0 1em; }
			}
			/* ── Related posts ── */
			.related-posts {
				max-width: 720px;
				margin: 2.5em auto 0;
				padding: 0 1.5em 1em;
			}
			.related-title {
				font-size: 1em;
				color: var(--accent-dark);
				border-left: 4px solid var(--accent);
				padding-left: 0.6em;
				margin-bottom: 0.8em;
			}
			.related-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 0.1em;
			}
			.related-list a {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1em;
				padding: 0.55em 0.4em;
				text-decoration: none;
				color: rgb(var(--gray-dark));
				border-bottom: 1px solid rgb(var(--gray-light));
				font-size: 0.88em;
			}
			.related-list a:hover { color: var(--accent-dark); }
			.related-post-title { flex: 1; }
			.related-post-date { font-size: 0.85em; color: rgb(var(--gray)); white-space: nowrap; }
			/* ── 楽天市場 banner ── */
			.rakuten-bar {
				background: #f5f5f5;
				border-bottom: 1px solid #e8e8e8;
				padding: 0.7em 1.5em;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.8em;
				flex-wrap: wrap;
			}
			.rakuten-bar-label {
				font-size: 0.62em;
				font-weight: 700;
				letter-spacing: 0.08em;
				color: #999;
				text-transform: uppercase;
				white-space: nowrap;
			}
			.rakuten-bar a img {
				display: block;
				max-height: 40px;
				width: auto;
			}
			.rakuten-bar-note {
				font-size: 0.6em;
				color: #bbb;
				white-space: nowrap;
			}
			/* ── note CTA ── */
			.note-cta {
				max-width: 720px;
				margin: 1.5em auto 0;
				padding: 0 1.5em;
			}
			.note-cta-box {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1em;
				background: linear-gradient(135deg, #1a2535 0%, #0f3a2a 100%);
				border-radius: 10px;
				padding: 1.2em 1.5em;
				flex-wrap: wrap;
			}
			.note-cta-text { flex: 1; }
			.note-cta-label {
				font-size: 0.65em;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: #5dcca8;
				margin-bottom: 0.3em;
			}
			.note-cta-title {
				font-size: 0.95em;
				font-weight: 700;
				color: white;
				line-height: 1.35;
			}
			.note-cta-desc {
				font-size: 0.72em;
				color: rgba(255,255,255,0.55);
				margin-top: 0.2em;
			}
			.note-cta-btn {
				display: inline-block;
				background: #5dcca8;
				color: #0f2820;
				font-size: 0.82em;
				font-weight: 700;
				padding: 0.6em 1.4em;
				border-radius: 6px;
				text-decoration: none;
				white-space: nowrap;
				transition: background 0.15s;
			}
			.note-cta-btn:hover { background: #7de0be; }
			/* ── Comments ── */
			.comments-wrap {
				max-width: 720px;
				margin: 0 auto;
				padding: 0 1.5em 3em;
			}
			/* ── Share buttons ── */
			.share-section {
				max-width: 720px;
				margin: 1.5em auto 0;
				padding: 0 1.5em;
				display: flex;
				align-items: center;
				gap: 1em;
				flex-wrap: wrap;
			}
			.share-label {
				font-size: 0.72em;
				font-weight: 700;
				letter-spacing: 0.08em;
				color: rgb(var(--gray));
				text-transform: uppercase;
			}
			.share-buttons { display: flex; gap: 0.5em; flex-wrap: wrap; }
			.share-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				font-size: 0.78em;
				font-weight: 600;
				padding: 0.45em 1em;
				border-radius: 5px;
				text-decoration: none;
				transition: opacity 0.15s;
			}
			.share-btn:hover { opacity: 0.8; }
			.hatena-btn { background: #00a4de; color: white; }
			.x-btn { background: #000; color: white; }
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article data-pagefind-body>
				{stockCard ? (
					<div class={`stock-hero${stockCard.cardTheme === 'event' ? ' theme-event' : ''}`}>
						<div class="stock-hero-inner">
							<div class="stock-hero-top">
								<div>
									<div class="stock-badge">銘柄分析 — {stockCard.category}</div>
									<div class="stock-name">
										{stockCard.companyName}
										<span class="stock-ticker">（{stockCard.ticker}）</span>
									</div>
									<div class="stock-category">{stockCard.category}</div>
								</div>
								<div class="stock-verdict">
									<div class="verdict-label">{stockCard.cardTheme === 'event' ? 'TOB・売却決着時の 期待価格' : '3年保有想定の 期待価格'}</div>
									<div class="verdict-price">{stockCard.targetPrice.toLocaleString()}円</div>
									<div class="verdict-upside">現在比 {stockCard.upside}</div>
								</div>
							</div>
							<div class="stock-scenario-note">{stockCard.cardTheme === 'event' ? 'TOB・売却公表で決着 — 売却中止・長期化なら撤退を検討' : 'シナリオが大きく崩れない限り保有継続 — 崩れた場合は売却を検討'}</div>
							<div class="stock-kpis">
								<div class="kpi">
									<div class="kpi-label">現在株価</div>
									<div class="kpi-value amber">{stockCard.currentPrice.toLocaleString()}円</div>
									<div class="kpi-asof">{priceAsOf}時点</div>
								</div>
								<div class="kpi">
									<div class="kpi-label">3年期待価格</div>
									<div class="kpi-value green">{stockCard.targetPrice.toLocaleString()}円</div>
								</div>
								<div class="kpi">
									<div class="kpi-label">期待リターン</div>
									<div class="kpi-value green">{stockCard.upside}</div>
								</div>
								<div class="kpi">
									<div class="kpi-label">最大下落</div>
									<div class="kpi-value red">{stockCard.downside}</div>
								</div>
								<div class="kpi">
									<div class="kpi-label">修正PBR</div>
									<div class="kpi-value red">{stockCard.modifiedPBR}</div>
								</div>
							</div>
							{stockCard && analysisFile && (
								<div class="stock-analysis-link">
									<a href={`/analysis/${analysisFile}.html`} target="_blank" rel="noopener">
										📊 完全版分析資料を見る（全タブ展開）→
									</a>
								</div>
							)}
						</div>
					</div>
				) : (
					<div class="hero-image">
						{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
					</div>
				)}
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{updatedDate && (
								<div class="last-updated-on">
									Last updated on <FormattedDate date={updatedDate} />
								</div>
							)}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>

			<div class="share-section">
				<span class="share-label">シェアする</span>
				<div class="share-buttons">
					<a href={`https://b.hatena.ne.jp/add?mode=confirm&url=${encodeURIComponent(Astro.url.href)}&title=${encodeURIComponent(title)}`}
					   target="_blank" rel="noopener noreferrer" class="share-btn hatena-btn">
						<img src="https://b.st-hatena.com/images/v4/public/entry-button/button-only@2x.png"
						     alt="はてなブックマーク" width="16" height="16" style="vertical-align:middle;" />
						はてブ
					</a>
					<a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.href)}&hashtags=バリュー投資,日本株`}
					   target="_blank" rel="noopener noreferrer" class="share-btn x-btn">
						𝕏 シェア
					</a>
				</div>
			</div>

			{allPosts.length > 0 && (
				<aside class="related-posts">
					<h2 class="related-title">関連記事</h2>
					<ul class="related-list">
						{allPosts.map(p => (
							<li>
								<a href={`/blog/${p.id}/`}>
									<span class="related-post-title">{p.data.title}</span>
									<span class="related-post-date"><FormattedDate date={p.data.pubDate} /></span>
								</a>
							</li>
						))}
					</ul>
				</aside>
			)}

{noteUrl && (
				<div class="note-cta">
					<a class="note-cta-box" href={noteUrl} target="_blank" rel="noopener">
						<div class="note-cta-text">
							<div class="note-cta-label">完全版レポート（無料公開）</div>
							<div class="note-cta-title">完全版分析レポートを読む</div>
							<div class="note-cta-desc">シナリオ試算・リスク完全版・財務モデル含む深掘り版を無料で公開中</div>
						</div>
						<span class="note-cta-btn">読みに行く →</span>
					</a>
				</div>
			)}

			<div class="comments-wrap">
				<Comments pageId={Astro.url.pathname} />
			</div>
		</main>
		<Footer />
	</body>
</html>
